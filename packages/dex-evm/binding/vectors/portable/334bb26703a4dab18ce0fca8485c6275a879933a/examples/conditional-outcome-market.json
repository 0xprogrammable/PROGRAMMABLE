{
  "$schema": "urn:programmable:schema:market-template:v1",
  "protocol_spec_id": "programmable-protocol/0.1.0-draft.1",
  "namespace": "org.programmable.examples.conditional_outcome",
  "name": "conditional_outcome_market",
  "revision": "1",
  "summary": "An outcome-claim Engine that enters a terminal state after an authenticated external resolution input.",
  "domain_policy": {
    "selector_id": "org.programmable.policy.outcome_domain.v1",
    "description": "The Domain binds the exact Engine Revision, claim profile, and named external resolution dependency."
  },
  "asset_roles": [
    {
      "role_id": "org.programmable.role.collateral_asset.v1",
      "description": "The fungible asset funding outcome claims.",
      "cardinality": "one"
    },
    {
      "role_id": "org.programmable.role.outcome_claim.v1",
      "description": "An Engine-defined claim for one terminal outcome.",
      "cardinality": "one_or_more"
    }
  ],
  "actions": [
    {
      "action_id": "org.programmable.action.acquire_outcome_claim.v1",
      "description": "Debit bounded collateral and credit an Engine-defined outcome claim.",
      "required_protected_capabilities": [
        "programmable.capability.asset_move.v1",
        "programmable.capability.profile_operation.v1"
      ],
      "proposed_protected_effects": [
        "programmable.effect.asset_move.v1",
        "programmable.effect.profile_operation.v1"
      ],
      "opaque_engine_effects": []
    },
    {
      "action_id": "org.programmable.action.commit_resolution.v1",
      "description": "Bind the exact external resolution observation and enter a terminal Engine phase.",
      "required_protected_capabilities": [],
      "proposed_protected_effects": [],
      "opaque_engine_effects": [
        "org.programmable.examples.effect.engine_state_commit.v1"
      ]
    },
    {
      "action_id": "org.programmable.action.claim_terminal_value.v1",
      "description": "Redeem an entitled terminal claim under the selected exit profile.",
      "required_protected_capabilities": [
        "programmable.capability.asset_move.v1"
      ],
      "proposed_protected_effects": [
        "programmable.effect.asset_move.v1"
      ],
      "opaque_engine_effects": []
    }
  ],
  "extensions": {
    "org.programmable.examples.evidence_provenance": "ENGINE_ATTESTED",
    "org.programmable.examples.external_dependencies": [
      "resolution_oracle"
    ],
    "org.programmable.examples.non_guarantees": [
      "oracle_truth",
      "legal_status"
    ]
  }
}
