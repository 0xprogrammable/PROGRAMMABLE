{
  "name": "@programmable/realtime-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "envio start",
    "identity": "node scripts/deployment-identity.mjs",
    "identity:verify-live-baseline": "node scripts/deployment-identity.mjs --verify deployment-identity.live-baseline.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "envio": "3.2.1",
    "viem": "2.46.2"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "6.0.3",
    "vitest": "4.1.0",
    "yaml": "2.8.2"
  }
}
