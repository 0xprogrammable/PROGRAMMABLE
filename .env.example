# Required for Privy wallet sign-in. This public App ID comes from the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional. Use this when the Privy project has an App Client ID configured.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Required in production. Use two independent authenticated Ethereum RPCs.
ETHEREUM_RPC_URL=
ETHEREUM_RPC_URL_B=

# Optional for contract rehearsal. Use a reliable Sepolia RPC before broadcasting.
SEPOLIA_RPC_URL=

# Added automatically when the private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Required by Vercel Cron when refreshing the durable Mainnet index.
CRON_SECRET=
