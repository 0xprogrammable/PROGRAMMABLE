{
  "name": "launcher-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:sepolia": "PROGRAMMABLE_ONCHAIN_NETWORK=rehearsal NEXT_PUBLIC_PROGRAMMABLE_ONCHAIN_NETWORK=rehearsal next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "brand:favicons": "node scripts/generate-programmable-favicons.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "contracts:bootstrap": "cd contracts && ./scripts/bootstrap-deps.sh",
    "contracts:fmt": "cd contracts && forge fmt --check",
    "contracts:lint": "cd contracts && forge lint src script",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:test:deterministic": "cd contracts && forge test --no-match-path 'test/{AdaptiveCurveLaunchMainnetFork.t.sol,AdaptiveCurveMainnetFork.t.sol,ClassicV3MainnetFork.t.sol,DeployClassicV3InfrastructureV1Mainnet.t.sol,DeployClassicV3InfrastructureV1Sepolia.t.sol,DeployMainnetAdaptiveInfrastructureV1.t.sol,DeployMainnetMemeInfrastructureV1.t.sol,DeployMainnetMemeInfrastructureV2.t.sol,DeploySepoliaInfrastructureV1.t.sol,DeploySepoliaMemeInfrastructureV1.t.sol,DeploySepoliaMemeInfrastructureV2.t.sol,EthereumDeploymentSnapshot.t.sol,EthereumSepoliaDeploymentSnapshot.t.sol,LiquidityGrowthVaultMainnetFork.t.sol,MainnetMemeLifecycleFork.t.sol}'",
    "contracts:test:forks": "node contracts/scripts/verify-fork-tests-ci.mjs",
    "contracts:slither": "cd contracts && slither . --filter-paths 'lib|test|script' --exclude-dependencies",
    "contracts:official-deployments": "node contracts/scripts/verify-official-deployments.mjs",
    "contracts:variants": "node contracts/scripts/validate-launch-variants.mjs",
    "contracts:verify": "npm run contracts:bootstrap && npm run contracts:variants && npm run contracts:fmt && npm run contracts:lint && npm run contracts:build && npm run contracts:test",
    "contracts:verify:ci": "npm run contracts:bootstrap && npm run contracts:variants && npm run contracts:fmt && npm run contracts:lint && npm run contracts:build && npm run contracts:test:deterministic && npm run contracts:test:forks",
    "contracts:sepolia:validate": "cd contracts && forge test --match-path test/EthereumSepoliaDeploymentSnapshot.t.sol && forge test --match-path test/DeploySepoliaInfrastructureV1.t.sol && forge test --match-path test/DeploySepoliaMemeInfrastructureV1.t.sol",
    "contracts:mainnet:metamask": "node scripts/serve-mainnet-metamask-deployer.mjs",
    "contracts:v2:sepolia:check": "node scripts/serve-v2-metamask-deployer.mjs --check",
    "contracts:v2:sepolia:metamask": "node scripts/serve-v2-metamask-deployer.mjs",
    "contracts:v2:mainnet:check": "PROGRAMMABLE_DEPLOY_NETWORK=mainnet node scripts/serve-v2-metamask-deployer.mjs --check",
    "contracts:v2:mainnet:metamask": "PROGRAMMABLE_DEPLOY_NETWORK=mainnet node scripts/serve-v2-metamask-deployer.mjs",
    "contracts:classic-v3:mainnet:check": "node scripts/serve-classic-v3-metamask-deployer.mjs --check",
    "contracts:classic-v3:mainnet:metamask": "node scripts/serve-classic-v3-metamask-deployer.mjs",
    "contracts:deep-full-range:manifest": "node contracts/scripts/verify-deep-full-range-release-manifest.mjs",
    "contracts:deep-full-range:manifest:live": "node contracts/scripts/verify-deep-full-range-release-manifest.mjs --require-live",
    "contracts:deep-full-range:fork-preflight": "node contracts/scripts/verify-deep-full-range-fork-preflight.mjs",
    "contracts:deep-full-range:metamask": "node scripts/serve-deep-full-range-metamask-deployer.mjs",
    "contracts:deep-full-range:canary": "node scripts/serve-deep-mainnet-canary.mjs",
    "contracts:v2:verify-deployment": "node contracts/scripts/verify-v2-deployment.mjs",
    "contracts:token-list:schema": "node scripts/validate-token-list-schema.mjs",
    "contracts:mainnet:canary:check": "MEME_LAUNCH_NETWORK=mainnet MEME_LAUNCH_FIXTURE_JSON=contracts/release/mainnet-test-classic-v2.json node scripts/serve-sepolia-meme-launch.mjs --check",
    "contracts:mainnet:canary": "MEME_LAUNCH_NETWORK=mainnet MEME_LAUNCH_FIXTURE_JSON=contracts/release/mainnet-test-classic-v2.json node scripts/serve-sepolia-meme-launch.mjs",
    "contracts:mainnet:monitor:once": "MAINNET_MEME_DEPLOYMENT_JSON=contracts/deployments/mainnet-classic-v2.json node contracts/scripts/monitor-meme-v1.mjs --once",
    "contracts:mainnet:monitor": "MAINNET_MEME_DEPLOYMENT_JSON=contracts/deployments/mainnet-classic-v2.json node contracts/scripts/monitor-meme-v1.mjs",
    "contracts:mainnet:lifecycle:check": "node contracts/scripts/verify-mainnet-meme-lifecycle.mjs --check-config",
    "contracts:mainnet:lifecycle:verify": "node contracts/scripts/verify-mainnet-meme-lifecycle.mjs",
    "contracts:sepolia:launch-test": "node scripts/serve-sepolia-meme-launch.mjs",
    "contracts:v2:sepolia:test2": "MEME_LAUNCH_FIXTURE_JSON=contracts/release/test2-classic-v2.json node scripts/serve-sepolia-meme-launch.mjs",
    "contracts:sepolia:lifecycle:verify": "node contracts/scripts/verify-sepolia-meme-lifecycle.mjs"
  },
  "dependencies": {
    "@privy-io/node": "^0.27.0",
    "@privy-io/react-auth": "3.35.2",
    "@uniswap/sdk-core": "7.19.0",
    "@uniswap/universal-router-sdk": "5.11.1",
    "@uniswap/v4-sdk": "2.3.1",
    "@vercel/blob": "2.6.1",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.5"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@uniswap/universal-router-sdk": {
      "@openzeppelin/contracts@4.7.0": "4.9.6"
    },
    "adm-zip": "0.6.0",
    "axios": "1.18.1",
    "cookie": "0.7.2",
    "diff": "8.0.3",
    "postcss": "8.5.23",
    "serialize-javascript": "7.0.7",
    "sharp": "0.35.3",
    "tmp": "0.2.7",
    "undici": "8.9.0",
    "uuid": "11.1.1",
    "ws": "8.21.1"
  }
}
