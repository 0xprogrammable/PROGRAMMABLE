{
  "name": "launcher-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "contracts:bootstrap": "cd contracts && ./scripts/bootstrap-deps.sh",
    "contracts:fmt": "cd contracts && forge fmt --check",
    "contracts:lint": "cd contracts && forge lint src",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:slither": "cd contracts && slither . --filter-paths 'lib|test' --exclude-dependencies",
    "contracts:verify": "npm run contracts:bootstrap && npm run contracts:fmt && npm run contracts:lint && npm run contracts:build && npm run contracts:test"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.35.2",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.5"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "axios": "1.18.1",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "viem": {
      "ws": "8.21.1"
    }
  }
}
