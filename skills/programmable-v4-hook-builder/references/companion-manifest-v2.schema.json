{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:companion-manifest-v2",
  "title": "Programmable Companion Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "closureMethod",
    "repositoryUri",
    "numericRepositoryId",
    "revisionObjectId",
    "treeObjectId",
    "sourcePaths",
    "testPaths",
    "runtimePaths",
    "build",
    "githubActionsRunIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "closureMethod": {
      "const": "npm-package-lock-v3-static-module-closure-v1"
    },
    "repositoryUri": {
      "type": "string",
      "minLength": 24,
      "maxLength": 159
    },
    "numericRepositoryId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,63}$"
    },
    "revisionObjectId": {
      "$ref": "#/$defs/GitObjectId"
    },
    "treeObjectId": {
      "$ref": "#/$defs/GitObjectId"
    },
    "sourcePaths": {
      "$ref": "#/$defs/NonEmptyPathArray"
    },
    "testPaths": {
      "$ref": "#/$defs/NonEmptyPathArray"
    },
    "runtimePaths": {
      "$ref": "#/$defs/PathArray"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageManifestPath",
        "packageLockPath",
        "configurationPaths",
        "buildScript",
        "testScript"
      ],
      "properties": {
        "packageManifestPath": {
          "$ref": "#/$defs/RepositoryPath"
        },
        "packageLockPath": {
          "$ref": "#/$defs/RepositoryPath"
        },
        "configurationPaths": {
          "$ref": "#/$defs/PathArray"
        },
        "buildScript": {
          "$ref": "#/$defs/ScriptName"
        },
        "testScript": {
          "$ref": "#/$defs/ScriptName"
        }
      }
    },
    "githubActionsRunIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,63}$"
      }
    }
  },
  "$defs": {
    "GitObjectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "RepositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*\\\\)(?!.*(?:%2[fF]|%5[cC]))(?!.*\\/$)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "PathArray": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/RepositoryPath"
      }
    },
    "NonEmptyPathArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/RepositoryPath"
      }
    },
    "ScriptName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,63}$"
    }
  }
}
