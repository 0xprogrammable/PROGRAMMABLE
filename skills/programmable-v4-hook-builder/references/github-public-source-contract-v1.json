{
  "contract": "GitHubPublicSourceContractV1",
  "schemaVersion": "1.0.0",
  "status": "frozen",
  "scope": "read-only public GitHub source resolution",
  "canonicalProviderOrigin": "https://github.com",
  "apiOrigin": "https://api.github.com",
  "githubApiVersion": "2026-03-10",
  "schemaSha256": "sha256:24e833898dd8eb09b72f5b7e4c5bd1f233fb0965d8462358316cee206c5777a1",
  "requestSchema": "github-public-source-contract-v1.schema.json#/$defs/GitHubPublicSourceRequestV1",
  "resultSchema": "github-public-source-contract-v1.schema.json#/$defs/GitHubPublicSourceResultV1",
  "errorSchema": "github-public-source-contract-v1.schema.json#/$defs/GitHubPublicSourceErrorV1",
  "authority": [
    "numericRepositoryId",
    "revisionObjectId",
    "treeObjectId"
  ],
  "displayOnly": [
    "repositoryUri",
    "owner",
    "repository",
    "defaultBranch"
  ],
  "invariants": {
    "publicRepositoryOnly": true,
    "acceptsCredentials": false,
    "followsRedirects": false,
    "acceptsMutableRevision": false,
    "acceptsAbbreviatedObjectIds": false,
    "pullRequestNumberIsAuthority": false,
    "pullRequestTextIsAuthority": false,
    "branchIsAuthority": false,
    "slugIsAuthority": false,
    "commitMustResolveInRepository": true,
    "commitTreeMustEqualRequestedTree": true,
    "treeMustResolveInRepository": true,
    "actionsEvidenceMustMatchRepositoryCommitAndTree": true,
    "declaredPathsMustExistInExactTree": true,
    "recursiveTreeTruncationTrusted": false,
    "exactObjectFallbackRequiredForTruncation": true,
    "declaredObjectsMustBeRegularBlobs": true,
    "declaredObjectsMustNotBeGitLfsPointers": true,
    "candidateGitHooksOrConfigExecuted": false
  },
  "ordering": {
    "companions": "unique numericRepositoryId, unsigned UTF-8 byte order",
    "sourcePaths": "unique canonical path, unsigned UTF-8 byte order",
    "contractPaths": "unique canonical path, unsigned UTF-8 byte order",
    "githubActionsEvidence": "unique runId, unsigned UTF-8 byte order",
    "jsonObjectKeys": "unsigned UTF-8 byte order"
  },
  "limits": {
    "companions": 8,
    "pathsPerKind": 512,
    "pathsTotal": 512,
    "actionsRunsPerRepository": 16,
    "pathBytes": 1024,
    "opaqueIdDigits": 64,
    "defaultTimeoutMs": 10000,
    "minimumTimeoutMs": 10,
    "maximumTimeoutMs": 30000,
    "anonymousRestRequests": 48,
    "reviewFileBytes": 2000000,
    "reviewTotalBytes": 20000000,
    "defaultTotalResponseBytes": 16777216,
    "minimumTotalResponseBytes": 1024,
    "maximumTotalResponseBytes": 67108864
  },
  "transport": {
    "method": "GET",
    "accept": "application/vnd.github+json",
    "userAgent": "programmable-github-public-source-v1",
    "redirect": "error",
    "authorizationHeader": false,
    "apiVersionHeader": "X-GitHub-Api-Version: 2026-03-10",
    "exactObjectTransport": {
      "protocol": "anonymous HTTPS Git smart protocol v2",
      "repositoryHost": "github.com",
      "credentials": false,
      "checkout": false,
      "submodules": false,
      "hooks": false,
      "globalOrSystemConfig": false,
      "minimumGitVersion": "2.49.0",
      "partialCloneFilter": "blob:none",
      "materialization": "git backfill --sparse followed by raw git cat-file --batch",
      "temporaryRepositoryBytes": 67108864,
      "temporaryRepositoryEnforcement": "process monitoring plus post-command measurement; not a filesystem quota"
    }
  },
  "errors": [
    "GITHUB_ACTIONS_RUN_MISMATCH",
    "GITHUB_ACTIONS_RUN_NOT_SUCCESSFUL",
    "GITHUB_ACTIONS_RUN_NOT_REACHABLE",
    "GITHUB_ACTIONS_WORKFLOW_NOT_IN_TREE",
    "GITHUB_COMMIT_MISMATCH",
    "GITHUB_COMMIT_NOT_REACHABLE",
    "GITHUB_DECLARED_PATH_NOT_FOUND",
    "GITHUB_NETWORK_ERROR",
    "GITHUB_PROTOCOL_ERROR",
    "GITHUB_PUBLIC_REPOSITORY_UNAVAILABLE",
    "GITHUB_RATE_LIMITED",
    "GITHUB_REDIRECT_REJECTED",
    "GITHUB_REPOSITORY_ID_MISMATCH",
    "GITHUB_REPOSITORY_LOCATOR_MISMATCH",
    "GITHUB_RESPONSE_TOO_LARGE",
    "GITHUB_TIMEOUT",
    "GITHUB_TREE_MISMATCH",
    "GITHUB_TREE_NOT_REACHABLE",
    "GITHUB_TREE_TRUNCATED",
    "GITHUB_UNAVAILABLE",
    "GITHUB_UPSTREAM_REJECTED",
    "INVALID_OPTIONS",
    "INVALID_REQUEST"
  ],
  "officialApiReferences": [
    "https://docs.github.com/en/rest/about-the-rest-api/api-versions?apiVersion=2026-03-10",
    "https://docs.github.com/en/rest/repos/repos?apiVersion=2026-03-10#get-a-repository",
    "https://docs.github.com/en/rest/git/commits?apiVersion=2026-03-10#get-a-commit-object",
    "https://docs.github.com/en/rest/git/trees?apiVersion=2026-03-10#get-a-tree",
    "https://docs.github.com/en/rest/actions/workflow-runs?apiVersion=2026-03-10#get-a-workflow-run",
    "https://git-scm.com/docs/partial-clone",
    "https://git-scm.com/docs/git-backfill",
    "https://git-scm.com/docs/git-cat-file"
  ]
}
