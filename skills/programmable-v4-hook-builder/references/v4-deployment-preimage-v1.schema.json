{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:v4-deployment-preimage:1.0.0",
  "title": "Programmable Uniswap v4 CREATE2 preimage",
  "description": "Exact final creation code, constructor arguments, and mined CREATE2 salt. Any byte change invalidates the derived hook address.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "systemRef", "creationCode", "constructorArgs", "salt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "systemRef": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "creationCode": { "type": "string", "minLength": 4, "maxLength": 4194306 },
    "constructorArgs": { "type": "string", "minLength": 2, "maxLength": 262146 },
    "salt": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
