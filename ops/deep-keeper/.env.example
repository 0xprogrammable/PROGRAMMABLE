# Deep stays read-and-simulate only unless both switches are explicitly true.
DEEP_KEEPER_ENABLED=false
DEEP_KEEPER_SEND_TRANSACTIONS=false

DEEP_KEEPER_CHAIN_ID=1
DEEP_KEEPER_COORDINATOR_ADDRESS=
DEEP_KEEPER_COORDINATOR_RUNTIME_HASH=
# Activation is bound to this exact checked-in release record.
DEEP_KEEPER_RELEASE_MANIFEST=contracts/deployments/mainnet-deep-full-range-v1.json

# Exactly two independent authenticated HTTPS read endpoints.
DEEP_KEEPER_RPC_URLS=https://rpc-a.example,https://rpc-b.example

# Required only when both activation switches are true. The endpoint must use
# a remote signer that exposes only this dedicated, gas-funded account.
DEEP_KEEPER_SIGNER_ADDRESS=
# Choose exactly one signing backend.
DEEP_KEEPER_SIGNER_RPC_URL=
DEEP_KEEPER_PRIVY_WALLET_ID=

DEEP_KEEPER_CONFIRMATIONS=12
DEEP_KEEPER_INTERVAL_MS=300000
DEEP_KEEPER_SCAN_LIMIT=4
# The reviewed 3,000,000-gas envelope supports at most four vaults.
# Values from five to eight require an explicit DEEP_KEEPER_MAX_GAS >= 6000000.
# Values above eight are always rejected.
DEEP_KEEPER_MAX_BATCH_SIZE=4
DEEP_KEEPER_MAX_GAS=3000000
DEEP_KEEPER_MAX_FEE_PER_GAS_WEI=100000000000
DEEP_KEEPER_MAX_SIGNER_BALANCE_WEI=500000000000000000
# 0.03 ETH in wei. Change only through reviewed operations configuration.
DEEP_KEEPER_VAULT_SUBSIDY_CAP_WEI=30000000000000000
DEEP_KEEPER_PENDING_TIMEOUT_MS=1800000
DEEP_KEEPER_STATE_FILE=./var/deep-keeper-state.json
DEEP_KEEPER_HEALTH_HOST=127.0.0.1
DEEP_KEEPER_HEALTH_PORT=9464
