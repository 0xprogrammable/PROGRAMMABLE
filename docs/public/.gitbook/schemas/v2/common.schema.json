{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developers.programmable.family/schemas/v2/common.schema.json",
  "title": "Programmable API v1 common values",
  "$defs": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "category": {
      "enum": [
        "classic",
        "custom"
      ]
    },
    "evmAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "nullableEvmAddress": {
      "oneOf": [
        {
          "$ref": "#/$defs/evmAddress"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "nullableHash32": {
      "oneOf": [
        {
          "$ref": "#/$defs/hash32"
        },
        {
          "type": "null"
        }
      ]
    },
    "decimalString": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "nullableDecimalString": {
      "oneOf": [
        {
          "$ref": "#/$defs/decimalString"
        },
        {
          "type": "null"
        }
      ]
    },
    "decimalAmount": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "nullableDecimalAmount": {
      "oneOf": [
        {
          "$ref": "#/$defs/decimalAmount"
        },
        {
          "type": "null"
        }
      ]
    },
    "isoDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "nullableIsoDateTime": {
      "oneOf": [
        {
          "$ref": "#/$defs/isoDateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://(?![^/?#]*@)[^\\s]+$"
    },
    "nullableHttpsUrl": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpsUrl"
        },
        {
          "type": "null"
        }
      ]
    },
    "openIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]*/[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
      },
      "additionalProperties": true
    }
  }
}
