{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developers.programmable.family/schemas/v2/custom-launch-chain-deployment-v4.schema.json",
  "title": "Public Custom Launch V4 chain deployment",
  "type": "object",
  "required": [
    "schemaVersion",
    "chainDeploymentId",
    "chainId",
    "caip2",
    "finality",
    "foundationSourceCommitment",
    "deploymentEvidence",
    "permit2GenesisProvenance",
    "permitAuthoritySourceProvenance",
    "externalRootDeploymentEvidence",
    "contracts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.custom-launch-chain-deployment.v1"
    },
    "chainDeploymentId": {
      "const": "robinhood-mainnet-custom-launch-v1"
    },
    "chainId": {
      "const": "4663"
    },
    "caip2": {
      "const": "eip155:4663"
    },
    "finality": {
      "$ref": "#/$defs/finalityPolicy"
    },
    "foundationSourceCommitment": {
      "const": "0xe87f5edc2dc839bd87a26a80cb53f14b021e603a1753d27aae3a02862058d730"
    },
    "deploymentEvidence": {
      "$ref": "#/$defs/programmableDeploymentEvidence"
    },
    "permit2GenesisProvenance": {
      "$ref": "#/$defs/permit2GenesisProvenance"
    },
    "permitAuthoritySourceProvenance": {
      "$ref": "#/$defs/permitAuthoritySourceProvenance"
    },
    "externalRootDeploymentEvidence": {
      "$ref": "#/$defs/externalRootDeploymentEvidence"
    },
    "contracts": {
      "$ref": "#/$defs/contracts"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hash32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "nonzeroHash32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
    },
    "lowerHash32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "lowerNonzeroHash32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "finalityPolicy": {
      "type": "object",
      "required": [
        "schemaVersion",
        "policyId",
        "policyRevision",
        "policyDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.custom-launch-finality-policy-ref.v1"
        },
        "policyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1
        },
        "policyDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "programmableDeploymentEvidence": {
      "type": "object",
      "required": [
        "schemaVersion",
        "deploymentId",
        "chainId",
        "coveredContracts",
        "transactionHash",
        "from",
        "to",
        "valueWei",
        "selector",
        "calldataHash",
        "calldataBytes",
        "nonce",
        "transactionIndex",
        "receiptStatus",
        "blockNumber",
        "blockHash",
        "receiptLogs",
        "receiptLogsDigest",
        "providerReadbacks",
        "resultingContracts",
        "ethereumFinalityEvidence",
        "evidenceDigest",
        "sourceVerification"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.robinhood-atomic-root-deployment-evidence.v1"
        },
        "deploymentId": {
          "const": "robinhood-mainnet-custom-launch-v1"
        },
        "chainId": {
          "const": "4663"
        },
        "coveredContracts": {
          "const": [
            "programmableLaunchStampRouter",
            "graphFactory",
            "permitAuthority"
          ]
        },
        "transactionHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "from": {
          "enum": [
            "0x032b1c7b96793717F0BD2f11eb86cd10CdefC4a3",
            "0x2Bb333d48DFAF1596D9036671d2E43168994249E"
          ]
        },
        "to": {
          "const": "0xcA11bde05977b3631167028862bE2a173976CA11"
        },
        "valueWei": {
          "const": "0"
        },
        "selector": {
          "const": "0x82ad56cb"
        },
        "calldataHash": {
          "const": "0x3ba04469085b17e12843a94c154a335c9c384837f8f6531f179cb4915fd237d9"
        },
        "calldataBytes": {
          "const": 33412
        },
        "nonce": {
          "$ref": "#/$defs/decimal"
        },
        "transactionIndex": {
          "$ref": "#/$defs/decimal"
        },
        "receiptStatus": {
          "const": "1"
        },
        "blockNumber": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "blockHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "receiptLogs": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/atomicReceiptLog"
          }
        },
        "receiptLogsDigest": {
          "$ref": "#/$defs/sha256"
        },
        "providerReadbacks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/atomicProviderReadback"
                },
                {
                  "type": "object",
                  "properties": {
                    "providerId": {
                      "const": "drpc"
                    },
                    "trustDomain": {
                      "const": "drpc.org"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/atomicProviderReadback"
                },
                {
                  "type": "object",
                  "properties": {
                    "providerId": {
                      "const": "alchemy"
                    },
                    "trustDomain": {
                      "const": "alchemy.com"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "resultingContracts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/atomicResult"
                },
                {
                  "type": "object",
                  "properties": {
                    "contract": {
                      "const": "permitAuthority"
                    },
                    "address": {
                      "const": "0xeD617CE7f82e2AB589aDeFFD319D1D872Bc8De06"
                    },
                    "runtimeCodeHash": {
                      "const": "0xd7d408ebcd99b2b70be43e20253d6d92a8ea8fab29bd3be7f55b10032331fb4c"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/atomicResult"
                },
                {
                  "type": "object",
                  "properties": {
                    "contract": {
                      "const": "graphFactory"
                    },
                    "address": {
                      "const": "0x0B6b3F40f84Df25D3bd69238f937096177DD09Bd"
                    },
                    "runtimeCodeHash": {
                      "const": "0xd23692fae59331592048e71a96d4963e170ee56e449683dc9f7fa3f9470018b8"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/atomicResult"
                },
                {
                  "type": "object",
                  "properties": {
                    "contract": {
                      "const": "programmableLaunchStampRouter"
                    },
                    "address": {
                      "const": "0x34965F2A2ee9254522232C32F02056E92BE0C98a"
                    },
                    "runtimeCodeHash": {
                      "const": "0x1dbbdaaad901ea3c6134dca0d4872a4789b3c071bf8ccfb44edd65d26d817388"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "ethereumFinalityEvidence": {
          "$ref": "#/$defs/ethereumFinalityEvidence"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "sourceVerification": {
          "const": {
            "sourcifyExactMatchCoveredContracts": [
              "programmableLaunchStampRouter",
              "graphFactory"
            ],
            "officialSourcePinnedCoveredContracts": [
              "permitAuthority"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "atomicReceiptLog": {
      "type": "object",
      "required": [
        "address",
        "topics",
        "data",
        "logIndex"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "topics": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/lowerNonzeroHash32"
          }
        },
        "data": {
          "type": "string",
          "pattern": "^0x(?:[0-9a-f]{2})*$"
        },
        "logIndex": {
          "$ref": "#/$defs/decimal"
        }
      },
      "additionalProperties": false
    },
    "atomicProviderReadback": {
      "type": "object",
      "required": [
        "providerId",
        "trustDomain",
        "transactionHash",
        "transactionResponseDigest",
        "transactionReceiptDigest",
        "evidenceDigest"
      ],
      "properties": {
        "providerId": {
          "type": "string"
        },
        "trustDomain": {
          "type": "string"
        },
        "transactionHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "transactionResponseDigest": {
          "$ref": "#/$defs/sha256"
        },
        "transactionReceiptDigest": {
          "$ref": "#/$defs/sha256"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "atomicResult": {
      "type": "object",
      "required": [
        "contract",
        "address",
        "runtimeCodeHash",
        "previousBlockRuntimeCodeHash",
        "providerReadbacks",
        "stateEvidenceDigest"
      ],
      "properties": {
        "contract": {
          "type": "string"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "previousBlockRuntimeCodeHash": {
          "const": "0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470"
        },
        "providerReadbacks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/atomicRootTransitionReadback"
                },
                {
                  "type": "object",
                  "properties": {
                    "providerId": {
                      "const": "drpc"
                    },
                    "trustDomain": {
                      "const": "drpc.org"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/atomicRootTransitionReadback"
                },
                {
                  "type": "object",
                  "properties": {
                    "providerId": {
                      "const": "alchemy"
                    },
                    "trustDomain": {
                      "const": "alchemy.com"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "stateEvidenceDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "atomicRootTransitionReadback": {
      "type": "object",
      "required": [
        "schemaVersion",
        "providerId",
        "trustDomain",
        "contract",
        "address",
        "preDeploymentBlockNumber",
        "preDeploymentBlockHash",
        "preDeploymentRuntimeCodeHash",
        "deploymentBlockNumber",
        "deploymentBlockHash",
        "deploymentRuntimeCodeHash",
        "evidenceDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.robinhood-atomic-root-runtime-transition-provider-readback.v1"
        },
        "providerId": {
          "type": "string"
        },
        "trustDomain": {
          "type": "string"
        },
        "contract": {
          "enum": [
            "permitAuthority",
            "graphFactory",
            "programmableLaunchStampRouter"
          ]
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "preDeploymentBlockNumber": {
          "$ref": "#/$defs/decimal"
        },
        "preDeploymentBlockHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "preDeploymentRuntimeCodeHash": {
          "const": "0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470"
        },
        "deploymentBlockNumber": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "deploymentBlockHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "deploymentRuntimeCodeHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "permit2GenesisProvenance": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "address",
        "startBlock",
        "genesisSourceUrl",
        "genesisSourceDigest",
        "allocRuntimeCodeBytes",
        "providerReadbacks",
        "evidenceDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.custom-launch-genesis-provenance.v1"
        },
        "kind": {
          "const": "genesis-predeploy"
        },
        "address": {
          "const": "0x000000000022D473030F116dDEE9F6B43aC78BA3"
        },
        "startBlock": {
          "const": "0"
        },
        "genesisSourceDigest": {
          "const": "sha256:353e6f6441b47695b41cee0c3645cde8dd7492d2f7f574bfb6aa4371e41bb6ba"
        },
        "genesisSourceUrl": {
          "const": "https://cdn.robinhood.com/assets/generated_assets/hoodchain_docsite/chain-node-configs/robinhood-genesis.json"
        },
        "allocRuntimeCodeBytes": {
          "const": 9152
        },
        "providerReadbacks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/genesisProviderReadback"
                },
                {
                  "type": "object",
                  "properties": {
                    "providerId": {
                      "const": "drpc"
                    },
                    "trustDomain": {
                      "const": "drpc.org"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/genesisProviderReadback"
                },
                {
                  "type": "object",
                  "properties": {
                    "providerId": {
                      "const": "alchemy"
                    },
                    "trustDomain": {
                      "const": "alchemy.com"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "evidenceDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "genesisProviderReadback": {
      "type": "object",
      "required": [
        "schemaVersion",
        "providerId",
        "trustDomain",
        "blockNumber",
        "blockHash",
        "runtimeCodeHash",
        "evidenceDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.custom-launch-genesis-provider-readback.v1"
        },
        "providerId": {
          "type": "string"
        },
        "trustDomain": {
          "type": "string"
        },
        "blockNumber": {
          "const": "0"
        },
        "blockHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "runtimeCodeHash": {
          "const": "0x5208783f52488f7d3493e5e38311ab707c1d75457fe472a19b0b4d57d66a7fca"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "safeProvider": {
      "type": "object",
      "required": [
        "providerId",
        "trustDomain",
        "evidenceDigest"
      ],
      "properties": {
        "providerId": {
          "type": "string"
        },
        "trustDomain": {
          "type": "string"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "publicProfile": {
      "type": "object",
      "required": [
        "schemaVersion",
        "structuralProfileId",
        "businessProfileId",
        "admissionDescriptorDigest",
        "admissionPolicyDigest",
        "admissionSchemaDigest",
        "admissionBindingDigest",
        "profileRevision",
        "profileVersion",
        "profileDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.custom-launch-profile-ref.v4"
        },
        "structuralProfileId": {
          "const": "programmable.custom-launch.robinhood-mainnet.v1"
        },
        "businessProfileId": {
          "const": "robinhood-production-launch"
        },
        "admissionDescriptorDigest": {
          "const": "sha256:99b4ccabdaaf143bad28a8f6af441a1b93e1f113d0179236328b7fa594d1f948"
        },
        "admissionPolicyDigest": {
          "const": "sha256:31e6b286ca839b31cb1edfe30c05d9f334892f3d84377961dc10b93959c7e216"
        },
        "admissionSchemaDigest": {
          "const": "sha256:a28a6de6208d6ba7b65b4b706174509570955ba9ce9714624bcb2046ab7beae7"
        },
        "admissionBindingDigest": {
          "const": "sha256:f31643e6e9ff6d5409d59a2fc3ac7fb5ac9cfcb3af08e95c9478bc95ddfa66a2"
        },
        "profileRevision": {
          "const": 1
        },
        "profileVersion": {
          "const": "4.0.0"
        },
        "profileDigest": {
          "const": "sha256:484b1dc6e9091804fabc230f2b3a7504940fa00264f8e66e82a66a951e71f1a0"
        }
      },
      "additionalProperties": false
    },
    "ethereumFinalityEvidence": {
      "type": "object",
      "required": [
        "schemaVersion",
        "profile",
        "l2Checkpoint",
        "batchNumber",
        "l2Providers",
        "ethereumProviders",
        "rollup",
        "sequencerInbox",
        "postingTransactionHash",
        "postingBlockNumber",
        "postingBlockHash",
        "postingLogIndex",
        "ethereumFinalizedCheckpoint",
        "observedAt",
        "evidenceDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.robinhood-l2-checkpoint-ethereum-finality.v1"
        },
        "profile": {
          "$ref": "#/$defs/publicProfile"
        },
        "l2Checkpoint": {
          "type": "object",
          "required": [
            "blockNumber",
            "blockHash"
          ],
          "properties": {
            "blockNumber": {
              "$ref": "#/$defs/positiveDecimal"
            },
            "blockHash": {
              "$ref": "#/$defs/lowerNonzeroHash32"
            }
          },
          "additionalProperties": false
        },
        "batchNumber": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "l2Providers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "required": [
                "providerId",
                "trustDomain",
                "l1Confirmations"
              ],
              "properties": {
                "providerId": {
                  "const": "drpc"
                },
                "trustDomain": {
                  "const": "drpc.org"
                },
                "l1Confirmations": {
                  "$ref": "#/$defs/positiveDecimal"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "providerId",
                "trustDomain",
                "l1Confirmations"
              ],
              "properties": {
                "providerId": {
                  "const": "alchemy"
                },
                "trustDomain": {
                  "const": "alchemy.com"
                },
                "l1Confirmations": {
                  "$ref": "#/$defs/positiveDecimal"
                }
              },
              "additionalProperties": false
            }
          ],
          "items": false
        },
        "ethereumProviders": {
          "const": [
            {
              "providerId": "drpc",
              "trustDomain": "drpc.org"
            },
            {
              "providerId": "quicknode",
              "trustDomain": "quicknode.com"
            }
          ]
        },
        "rollup": {
          "const": "0x23A19d23e89166adedbDcB432518AB01e4272D94"
        },
        "sequencerInbox": {
          "const": "0xBd0D173EEb87D57A09521c24388a12789F33ba96"
        },
        "postingTransactionHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "postingBlockNumber": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "postingBlockHash": {
          "$ref": "#/$defs/lowerNonzeroHash32"
        },
        "postingLogIndex": {
          "$ref": "#/$defs/decimal"
        },
        "ethereumFinalizedCheckpoint": {
          "type": "object",
          "required": [
            "blockNumber",
            "blockHash",
            "tag"
          ],
          "properties": {
            "blockNumber": {
              "$ref": "#/$defs/positiveDecimal"
            },
            "blockHash": {
              "$ref": "#/$defs/lowerNonzeroHash32"
            },
            "tag": {
              "const": "finalized"
            }
          },
          "additionalProperties": false
        },
        "observedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "safeConfigurationEvidence": {
      "type": "object",
      "required": [
        "schemaVersion",
        "finalized",
        "blockNumber",
        "blockHash",
        "proxyRuntimeCodeHash",
        "singleton",
        "fallbackHandler",
        "fallbackHandlerRuntimeCodeHash",
        "owners",
        "threshold",
        "nonce",
        "modules",
        "modulesNext",
        "guard",
        "singletonSlot",
        "fallbackHandlerSlot",
        "guardSlot",
        "primaryProvider",
        "secondaryProvider",
        "atomicRootStateEvidenceDigest",
        "ethereumFinalityEvidence",
        "evidenceDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.safe-configuration-evidence.v1"
        },
        "finalized": {
          "const": true
        },
