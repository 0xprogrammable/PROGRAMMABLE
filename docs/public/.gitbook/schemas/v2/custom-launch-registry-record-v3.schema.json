{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.programmable.family/autonomous-approval/v1/custom-launch-registry-record-v3.schema.json",
  "title": "Canonical Programmable Custom launch Registry record v3",
  "description": "Exact approval, deployment, Registry, review, fee and finality bindings for a Programmable Custom launch. This producer schema id is exclusive; derived read-model projections must use a different schemaVersion.",
