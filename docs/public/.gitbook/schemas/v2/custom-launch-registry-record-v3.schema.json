            "string",
            "null"
          ],
          "maxLength": 256
        },
        "accrual": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "claim": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "rounding": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
