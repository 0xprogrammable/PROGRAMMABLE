  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platformId",
    "origin",
    "category",
    "launchFamily",
    "publicLabel",
    "projectId",
    "launchId",
    "model",
    "template",
    "partner",
    "registeredRecordPreimage",
    "registeredRecordComponentHashes",
    "registeredRecordCommitment",
    "registrationBindingHash",
    "registryOrigin",
    "approvalBinding",
    "deploymentBinding",
    "verifiedReview",
    "feePolicy",
    "onchainFeePolicy",
    "launchingWallet",
    "postLaunchAuthorityInventory",
    "postLaunchAuthorityInventoryHash",
    "launchIdentity",
    "advertisesToken",
    "discoverableAssets",
    "assetIdentitySetHash",
    "discoverableMarkets",
    "marketSetHash",
    "mechanisms",
    "capabilities",
    "finalityPolicy",
    "finality",
    "lifecycle",
    "presentationVersion",
    "presentationBindingHash",
    "presentation",
    "extensions",
    "envelopeDigest"
  ],
