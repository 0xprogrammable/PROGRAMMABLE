    "launchFamily": {
      "const": "custom"
    },
    "publicLabel": {
      "const": "Programmable Custom"
    },
    "projectId": {
      "$ref": "#/definitions/digest"
    },
    "launchId": {
      "$ref": "#/definitions/digest"
    },
    "model": {
      "$ref": "#/definitions/model"
    },
    "template": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/template"
        }
      ]
    },
    "partner": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/partner"
