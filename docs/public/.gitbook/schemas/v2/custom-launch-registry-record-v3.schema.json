    "marketSetHash": {
      "$ref": "#/definitions/digest"
    },
    "mechanisms": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/definitions/mechanism"
      }
    },
    "capabilities": {
