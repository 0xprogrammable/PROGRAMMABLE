          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/safeId"
          }
        },
        "normalProgrammableTenBpsApplied": {
          "type": "boolean"
        },
        "verificationStatus": {
          "enum": [
            "verified",
            "not_applicable"
          ]
        },
        "verificationAuthorityHash": {
          "$ref": "#/definitions/digest"
        },
        "verificationEvidenceHash": {
          "$ref": "#/definitions/digest"
        },
        "recipientControlEvidenceHash": {
          "$ref": "#/definitions/digest"
        },
        "claimIsolationEvidenceHash": {
          "$ref": "#/definitions/digest"
        },
        "verifiedAt": {
          "$ref": "#/definitions/timestamp"
        },
        "publicPolicyBindingHash": {
          "$ref": "#/definitions/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "native"
              }
            }
          },
          "then": {
            "properties": {
              "totalFeeBps": {
                "const": 10
              },
              "programmableShareBps": {
                "const": 10
              },
              "partnerShareBps": {
                "const": 0
              },
              "partnerRecipient": {
                "type": "null"
              },
              "chargeMode": {
                "const": "verified-official-market-path-only"
              },
              "normalProgrammableTenBpsApplied": {
                "const": true
              },
              "verificationStatus": {
                "const": "verified"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "partner-template"
              }
            }
          },
          "then": {
            "properties": {
              "totalFeeBps": {
                "const": 20
              },
              "programmableShareBps": {
                "const": 5
              },
              "partnerShareBps": {
                "const": 15
              },
              "partnerRecipient": {
                "$ref": "#/definitions/identity"
              },
              "chargeMode": {
                "const": "template-native-verified-market-path"
              },
              "normalProgrammableTenBpsApplied": {
                "const": false
              },
              "verificationStatus": {
                "const": "verified"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "no-qualifying-market"
              }
            }
          },
          "then": {
            "properties": {
              "totalFeeBps": {
                "const": 0
              },
              "programmableShareBps": {
                "const": 0
              },
              "partnerShareBps": {
                "const": 0
              },
              "partnerRecipient": {
                "type": "null"
              },
              "chargeMode": {
                "const": "none-no-qualifying-market"
              },
              "basis": {
                "type": "null"
              },
              "currency": {
                "type": "null"
              },
              "accrual": {
                "type": "null"
              },
              "claim": {
                "type": "null"
              },
              "rounding": {
                "type": "null"
              },
              "verifiedMarketIds": {
                "type": "array",
                "maxItems": 0
              },
              "normalProgrammableTenBpsApplied": {
                "const": false
              },
              "verificationStatus": {
                "const": "not_applicable"
              }
            }
          }
        }
      ]
    },
