        "url": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fqcn", "constructorArguments", "encodedConstructorArguments", "etherscan", "sourcify"],
      "properties": {
        "status": { "enum": ["not-submitted", "etherscan-exact-sourcify-match"] },
        "fqcn": { "type": "string", "minLength": 1 },
        "constructorArguments": { "type": "array" },
        "encodedConstructorArguments": {
          "anyOf": [{ "type": "string", "pattern": "^0x([0-9a-fA-F]{2})*$" }, { "type": "null" }]
        },
        "etherscan": { "$ref": "#/definitions/etherscanProviderRecord" },
        "sourcify": { "$ref": "#/definitions/sourcifyProviderRecord" }
      }
    },
    "sourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contracts"],
      "properties": {
        "status": { "enum": ["not-submitted", "verified"] },
        "contracts": {
          "allOf": [
            { "$ref": "#/definitions/runtimeFields" },
            {
              "properties": {
                "zapPlanner": { "$ref": "#/definitions/sourceRecord" },
                "growthVaultFactory": { "$ref": "#/definitions/sourceRecord" },
                "growthVaultImplementation": { "$ref": "#/definitions/sourceRecord" },
                "hookFactory": { "$ref": "#/definitions/sourceRecord" },
                "feeHook": { "$ref": "#/definitions/sourceRecord" },
                "launcher": { "$ref": "#/definitions/sourceRecord" },
                "positionPlanner": { "$ref": "#/definitions/sourceRecord" },
                "automation": { "$ref": "#/definitions/sourceRecord" },
                "keeperExecutor": { "$ref": "#/definitions/sourceRecord" }
              }
            }
          ]
        }
      }
    },
    "lifecycleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "releaseEligible", "requiredRelease", "evidencePath",
        "independentRpcCount", "canaryToken", "canaryVault", "poolId",
        "launchTransaction", "oracleTransaction", "compoundTransaction",
        "evidenceHash", "noActionKeeperCycle", "actionableKeeperCycle"
      ],
      "properties": {
        "status": { "enum": ["not-run", "verified-current-release"] },
        "releaseEligible": { "type": "boolean" },
        "requiredRelease": { "const": "deep-full-range-v3" },
        "evidencePath": { "const": "contracts/deployments/evidence/deep-full-range-mainnet-canary-v3.json" },
        "independentRpcCount": { "type": "integer", "minimum": 0 },
        "canaryToken": { "$ref": "#/definitions/nullableAddress" },
        "canaryVault": { "$ref": "#/definitions/nullableAddress" },
        "poolId": { "$ref": "#/definitions/nullableHash" },
        "launchTransaction": { "$ref": "#/definitions/nullableHash" },
        "oracleTransaction": { "$ref": "#/definitions/nullableHash" },
        "compoundTransaction": { "$ref": "#/definitions/nullableHash" },
        "evidenceHash": { "$ref": "#/definitions/nullableHash" },
        "noActionKeeperCycle": { "$ref": "#/definitions/keeperCycle" },
        "actionableKeeperCycle": { "$ref": "#/definitions/keeperCycle" }
      }
    },
    "keeperCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "outcome", "readyVaults", "submittedTransaction",
        "observedAtBlock", "successfulCandidates", "transactionHash",
        "blockNumber", "evidenceHash"
      ],
      "properties": {
        "status": { "enum": ["not-run", "verified-no-transaction", "verified-compound-confirmed"] },
        "outcome": { "enum": ["not-run", "idle", "confirmed-productive"] },
        "readyVaults": { "$ref": "#/definitions/nullableInteger" },
        "submittedTransaction": { "type": "boolean" },
        "observedAtBlock": { "$ref": "#/definitions/nullableInteger" },
        "successfulCandidates": { "$ref": "#/definitions/nullableInteger" },
        "transactionHash": { "$ref": "#/definitions/nullableHash" },
        "blockNumber": { "$ref": "#/definitions/nullableInteger" },
        "evidenceHash": { "$ref": "#/definitions/nullableHash" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appStatus", "keeperStatus", "requiresExactManifestMatch", "productionTransactionSubmission"],
      "properties": {
        "appStatus": { "enum": ["blocked", "ready"] },
        "keeperStatus": { "enum": ["blocked", "ready"] },
        "requiresExactManifestMatch": { "const": true },
        "productionTransactionSubmission": { "type": "boolean" }
      }
    }
