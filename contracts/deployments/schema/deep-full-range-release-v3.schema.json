                "growthVaultFactory": { "type": ["boolean", "null"] },
                "growthVaultImplementation": { "type": ["boolean", "null"] },
                "hookFactory": { "type": ["boolean", "null"] },
                "feeHook": { "type": ["boolean", "null"] },
                "launcher": { "type": ["boolean", "null"] },
                "positionPlanner": { "type": ["boolean", "null"] },
                "automation": { "type": ["boolean", "null"] },
                "keeperExecutor": { "type": ["boolean", "null"] }
              }
            }
          ]
        }
      }
    },
    "etherscanProviderRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "url"],
