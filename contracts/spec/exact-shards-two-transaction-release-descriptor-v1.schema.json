{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://programmable.invalid/spec/exact-shards-two-transaction-release-descriptor-v1.schema.json",
  "title": "Programmable Exact Shards two-transaction release descriptor V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "source",
    "configHash",
    "registryConfig",
    "chain",
    "deployer",
    "addresses",
    "artifacts",
    "dependencies",
    "transactions",
    "readbacks"
  ],
  "properties": {
    "schema": {
      "const": "programmable.exact-shards-two-transaction-release-descriptor.v1"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freezeStatus",
        "activationAllowed",
        "authorizationState",
        "authorizationHash",
        "authorizationPolicyHash",
        "authorizedReleaseActor",
        "maximumTotalFeeWei",
        "maximumExactHashBroadcastAttempts"
      ],
      "properties": {
        "freezeStatus": { "enum": ["DRAFT", "FROZEN"] },
        "activationAllowed": {
          "type": "boolean",
          "default": false,
          "description": "Must remain false until the exact source, artifacts, configuration, gas envelope, roles, and release authority are frozen."
        },
        "authorizationState": { "enum": ["NOT_AUTHORIZED", "AUTHORIZED"] },
        "authorizationHash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bytes32" }]
        },
        "authorizationPolicyHash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bytes32" }]
        },
        "authorizedReleaseActor": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/address" }]
        },
        "maximumTotalFeeWei": { "$ref": "#/$defs/quantity" }
        ,
        "maximumExactHashBroadcastAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "allOf": [
        {
          "if": { "properties": { "activationAllowed": { "const": true } } },
          "then": {
            "properties": {
              "freezeStatus": { "const": "FROZEN" },
              "authorizationState": { "const": "AUTHORIZED" },
              "authorizationHash": { "$ref": "#/$defs/bytes32" },
              "authorizationPolicyHash": { "$ref": "#/$defs/bytes32" },
              "authorizedReleaseActor": { "$ref": "#/$defs/address" }
            }
          },
          "else": {
            "properties": {
              "authorizationState": { "const": "NOT_AUTHORIZED" },
              "authorizationHash": { "type": "null" },
              "authorizationPolicyHash": { "type": "null" },
              "authorizedReleaseActor": { "type": "null" }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "treeHash",
        "buildInputHash",
        "artifactBundleHash"
      ],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeHash": { "$ref": "#/$defs/bytes32" },
        "buildInputHash": { "$ref": "#/$defs/bytes32" },
        "artifactBundleHash": { "$ref": "#/$defs/bytes32" }
      }
    },
    "configHash": { "$ref": "#/$defs/bytes32" },
    "registryConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialAdminDelay",
        "initialAdmin",
        "initialApprover",
        "initialLaunchIntentApprover",
        "initialWriter",
        "initialFinalizer",
        "initialRevoker",
        "registryGeneration",
        "minimumFinalityBlocks",
        "chainProfileHash",
        "registryPolicyHash"
      ],
      "properties": {
        "initialAdminDelay": { "$ref": "#/$defs/quantity" },
        "initialAdmin": { "$ref": "#/$defs/address" },
        "initialApprover": { "$ref": "#/$defs/address" },
        "initialLaunchIntentApprover": { "$ref": "#/$defs/address" },
        "initialWriter": { "$ref": "#/$defs/address" },
        "initialFinalizer": { "$ref": "#/$defs/address" },
        "initialRevoker": { "$ref": "#/$defs/address" },
        "registryGeneration": { "$ref": "#/$defs/quantity" },
        "minimumFinalityBlocks": { "$ref": "#/$defs/quantity" },
        "chainProfileHash": { "$ref": "#/$defs/bytes32" },
        "registryPolicyHash": { "$ref": "#/$defs/bytes32" }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "chainProfileHash",
        "readProviders",
        "maximumTransactionGas",
        "finality"
      ],
      "properties": {
        "chainId": { "$ref": "#/$defs/quantity" },
        "chainProfileHash": { "$ref": "#/$defs/bytes32" },
        "readProviders": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/readProvider" }
        },
        "maximumTransactionGas": { "$ref": "#/$defs/quantity" },
        "finality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumConfirmations", "maximumProviderHeadLag"],
          "properties": {
            "minimumConfirmations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "maximumProviderHeadLag": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          }
        }
      }
    },
    "deployer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "startingNonce"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "startingNonce": { "$ref": "#/$defs/quantity" }
      }
    },
    "addresses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "coordinator", "factory", "route"],
      "properties": {
        "registry": { "$ref": "#/$defs/address" },
        "coordinator": { "$ref": "#/$defs/address" },
        "factory": { "$ref": "#/$defs/address" },
        "route": { "$ref": "#/$defs/address" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "coordinator", "factory", "route"],
      "properties": {
        "registry": { "$ref": "#/$defs/creationArtifact" },
        "coordinator": { "$ref": "#/$defs/creationArtifact" },
        "factory": { "$ref": "#/$defs/runtimeArtifact" },
        "route": { "$ref": "#/$defs/runtimeArtifact" }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "address", "runtimeCodeHash", "runtimeByteLength"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "address": { "$ref": "#/$defs/address" },
          "runtimeCodeHash": { "$ref": "#/$defs/bytes32" },
          "runtimeByteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24576
          }
        }
      }
    },
    "transactions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/registryTransaction" },
        { "$ref": "#/$defs/coordinatorTransaction" }
      ]
    },
    "readbacks": {
      "type": "array",
      "minItems": 66,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "target",
          "signature",
          "args",
          "returnTypes",
          "expectedValue",
          "data",
          "expectedReturn"
        ],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "target": { "$ref": "#/$defs/address" },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\([^)]*\\)$"
          },
          "args": { "type": "array" },
          "returnTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "expectedValue": { "type": "array", "minItems": 1 },
          "data": { "$ref": "#/$defs/hex" },
          "expectedReturn": { "$ref": "#/$defs/hex" }
        }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
    },
    "hex": {
      "type": "string",
      "pattern": "^0x(?:[0-9a-fA-F]{2})*$"
    },
    "quantity": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^(?:0|[1-9][0-9]*|0x[0-9a-fA-F]+)$" }
      ]
    },
    "runtimeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeCodeHash", "runtimeByteLength", "sourceArtifactHash"],
      "properties": {
        "runtimeCodeHash": { "$ref": "#/$defs/bytes32" },
        "runtimeByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24576
        },
        "sourceArtifactHash": { "$ref": "#/$defs/bytes32" }
      }
    },
    "readProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "credentialProviderId",
        "canonicalOrigin",
        "trustDomain",
        "operatorIdentityHash",
        "endpointCommitment"
      ],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "credentialProviderId": { "type": "string", "minLength": 1 },
        "canonicalOrigin": {
          "type": "string",
          "pattern": "^https://[^/?#]+$"
        },
        "trustDomain": { "type": "string", "minLength": 1 },
        "operatorIdentityHash": { "$ref": "#/$defs/bytes32" },
        "endpointCommitment": { "$ref": "#/$defs/bytes32" }
      }
    },
    "creationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeCodeHash",
        "runtimeByteLength",
        "sourceArtifactHash",
        "initCodeHash",
        "initCodeByteLength"
      ],
      "properties": {
        "runtimeCodeHash": { "$ref": "#/$defs/bytes32" },
        "runtimeByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24576
        },
        "sourceArtifactHash": { "$ref": "#/$defs/bytes32" },
        "initCodeHash": { "$ref": "#/$defs/bytes32" },
        "initCodeByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 49152
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "type",
        "chainId",
        "from",
        "to",
        "nonce",
        "value",
        "data",
        "gas",
        "maxFeePerGas",
        "maxPriorityFeePerGas",
        "expectedContractAddress"
      ],
      "properties": {
        "step": { "type": "string" },
        "type": { "const": "eip1559" },
        "chainId": { "$ref": "#/$defs/quantity" },
        "from": { "$ref": "#/$defs/address" },
        "to": { "type": "null" },
        "nonce": { "$ref": "#/$defs/quantity" },
        "value": { "$ref": "#/$defs/quantity" },
        "data": { "$ref": "#/$defs/hex" },
        "gas": { "$ref": "#/$defs/quantity" },
        "maxFeePerGas": { "$ref": "#/$defs/quantity" },
        "maxPriorityFeePerGas": { "$ref": "#/$defs/quantity" },
        "expectedContractAddress": { "$ref": "#/$defs/address" }
      }
    },
    "registryTransaction": {
      "allOf": [
        { "$ref": "#/$defs/transaction" },
        {
          "type": "object",
          "properties": { "step": { "const": "registry" } }
        }
      ]
    },
    "coordinatorTransaction": {
      "allOf": [
        { "$ref": "#/$defs/transaction" },
        {
          "type": "object",
          "properties": { "step": { "const": "coordinator" } }
        }
      ]
    }
  }
}
