  "properties": [
    {
      "id": "SP-EIP712-DOMAIN",
      "category": "signatures",
      "statement": "The permit digest uses EIP-712 name, version, chainId and permit-authority verifying contract and binds all 26 permit fields, the 17-field release and three-field kernel envelope.",
      "enforcement": "ONCHAIN_AND_GOLDEN_VECTOR",
      "componentIds": ["permitVerifier", "permitAuthority"],
      "evidenceIds": ["permit-golden", "permit-authority"],
      "invariantIds": ["INV-PERMIT-DIGEST"]
    },
    {
      "id": "SP-PERMIT-REPLAY",
      "category": "signatures",
      "statement": "A successful consume requires the current signer epoch and exact per-repository nonce, permanently consumes the repository lineage and launchId, and advances the nonce only on success.",
      "enforcement": "ONCHAIN",
      "componentIds": ["permitAuthority", "permitVerifier"],
      "evidenceIds": ["permit-authority", "cross-route-e2e"],
      "invariantIds": ["INV-PERMIT-REPLAY", "INV-REPOSITORY-ONCE"]
    },
    {
      "id": "SP-PERMIT-CANCELLATION",
      "category": "signatures",
      "statement": "Permit cancellation, approval-generation cancellation, signer disabling, time bounds and release retirement/deactivation fail closed without consuming a reusable nonce before one successful launch.",
      "enforcement": "ONCHAIN",
      "componentIds": ["permitAuthority", "permitVerifier"],
      "evidenceIds": ["permit-authority"],
      "invariantIds": ["INV-CANCELLATION"]
    },
    {
      "id": "SP-RELEASE-BINDING",
      "category": "signatures",
      "statement": "Release generations are monotonic and bind exact authority, verifier, registry, profile, route, runtime code hashes, route writer authority and execution authority.",
      "enforcement": "ONCHAIN",
      "componentIds": ["permitVerifier", "permitAuthority", "registry", "atomicLaunchRoute"],
      "evidenceIds": ["permit-authority", "real-graph-e2e"],
      "invariantIds": ["INV-RELEASE-GRAPH"]
    },
    {
      "id": "SP-CREATE2-GRAPH",
      "category": "deployment",
      "statement": "CREATE2 predictions bind wrapper deployer, salts, initcode, token and derived NFT metadata, renderer, ticks, price and recipients; direct implementation deployment cannot occupy the wrapper graph.",
      "enforcement": "ONCHAIN",
      "componentIds": ["reviewedFactoryImplementation", "routeGatedFactory", "shardToken", "shardHook", "shardNft"],
      "evidenceIds": ["route-factory", "shard-launch-factory"],
      "invariantIds": ["INV-CREATE2-PREDICTION"]
    },
    {
      "id": "SP-DELEGATECALL-GATE",
      "category": "deployment",
      "statement": "The wrapper accepts only launch from its immutable route, verifies the implementation runtime hash again before delegatecall, rejects fallback selectors and preserves the reviewed slot-zero mapping layout.",
      "enforcement": "ONCHAIN_AND_ARTIFACT_BINDING",
      "componentIds": ["reviewedFactoryImplementation", "routeGatedFactory", "atomicLaunchRoute"],
      "evidenceIds": ["route-factory"],
      "invariantIds": ["INV-DELEGATECALL-SURFACE"]
    },
    {
      "id": "SP-TRANSIENT-REENTRANCY",
      "category": "reentrancy",
      "statement": "Permit consumption and the full atomic launch entrypoint are guarded by Cancun transient-storage reentrancy locks; external effects revert atomically on callback failure.",
      "enforcement": "ONCHAIN_AND_EVM_PROFILE",
      "componentIds": ["permitAuthority", "atomicLaunchRoute"],
      "evidenceIds": ["real-graph-e2e", "hook-attacks"],
      "invariantIds": ["INV-ATOMIC-ROLLBACK"]
    },
    {
      "id": "SP-V4-RETURN-DELTA",
      "category": "uniswap-v4",
      "statement": "The canonical hook declares both beforeSwapReturnDelta and afterSwapReturnDelta and uses signed hook deltas to retain only the ETH fee while preserving PoolManager delta settlement.",
      "enforcement": "ONCHAIN_AND_UPSTREAM_V4_TESTS",
      "componentIds": ["poolManager", "shardHook"],
      "evidenceIds": ["hook-fees"],
      "invariantIds": ["INV-V4-NONNEGATIVE-DELTA"]
    },
    {
      "id": "SP-V4-PARTIAL-FILL",
      "category": "uniswap-v4",
      "statement": "When ETH is specified and a beforeSwap fee cannot be corrected on the unspecified return-delta side, any partial fill is rejected and leaves no fee; complete fills at the limit remain valid.",
      "enforcement": "ONCHAIN",
      "componentIds": ["shardHook"],
      "evidenceIds": ["hook-fees"],
      "invariantIds": ["INV-PARTIAL-FILL"]
    },
    {
      "id": "SP-V4-CANONICAL-POOL",
      "category": "uniswap-v4",
      "statement": "The hook permits only native ETH versus its immutable SHARD token, exact pool fee, tick spacing, hook address and reviewed start price, and rejects swaps before one-shot initialization or through a foreign pool.",
      "enforcement": "ONCHAIN",
      "componentIds": ["poolManager", "shardHook"],
      "evidenceIds": ["hook-fees", "hook-attacks"],
      "invariantIds": ["INV-CANONICAL-POOL"]
    },
    {
      "id": "SP-V4-FEE-ACCOUNTING",
      "category": "uniswap-v4",
      "statement": "Every swap quadrant charges the inclusive ETH fee with carried remainders; builder plus Programmable plus holder accounting conserves every wei and fees remain covered by ETH or ERC-6909 claims.",
      "enforcement": "ONCHAIN_AND_FUZZ",
      "componentIds": ["feePolicyVerifier", "registry", "shardHook"],
      "evidenceIds": ["fee-policy", "hook-fees", "fee-split"],
      "invariantIds": ["INV-FEE-CONSERVATION", "INV-FEE-CUMULATIVE", "INV-FEE-POLICY-IMMUTABLE"]
    },
    {
      "id": "SP-ROLLBACK-ATOMICITY",
      "category": "lifecycle",
      "statement": "Permit consumption, repository marking, factory deployment, graph validation and registry registration occur in one transaction so any downstream failure rolls every effect back and permits an exact retry.",
      "enforcement": "EVM_ATOMICITY_AND_E2E",
      "componentIds": ["permitAuthority", "atomicLaunchRoute", "routeGatedFactory", "registry"],
      "evidenceIds": ["real-graph-e2e", "registry-lifecycle"],
      "invariantIds": ["INV-ATOMIC-ROLLBACK"]
    },
    {
      "id": "SP-REPOSITORY-ONCE",
      "category": "lifecycle",
      "statement": "Repository uniqueness lives permanently in the stable Permit Authority across signer epochs, release generations and competing real route stacks; registry retry idempotence does not weaken it.",
      "enforcement": "ONCHAIN_AND_CROSS_ROUTE_E2E",
      "componentIds": ["permitAuthority", "registry", "atomicLaunchRoute"],
      "evidenceIds": ["permit-authority", "cross-route-e2e", "registry-lifecycle"],
      "invariantIds": ["INV-REPOSITORY-ONCE"]
    },
    {
      "id": "SP-FINALITY",
      "category": "lifecycle",
      "statement": "Finalization requires the observed block, transaction identity, configured minimum depth, nonzero one-use evidence and canonical observed and confirmed-head block hashes inside the native blockhash window.",
      "enforcement": "ONCHAIN",
      "componentIds": ["registry"],
      "evidenceIds": ["registry-lifecycle"],
      "invariantIds": ["INV-REGISTRY-MONOTONIC"]
    },
    {
      "id": "SP-REORG",
      "category": "lifecycle",
      "statement": "A reorg or stale proof fails closed when either supplied historical block hash differs from blockhash; unavailable history beyond 256 blocks cannot be treated as canonical evidence.",
      "enforcement": "ONCHAIN",
      "componentIds": ["registry"],
      "evidenceIds": ["registry-lifecycle"],
      "invariantIds": ["INV-REGISTRY-MONOTONIC"]
    },
    {
      "id": "SP-REGISTRY-LIFECYCLE",
      "category": "lifecycle",
      "statement": "Observed becomes finalized or terminally revoked; revision one and fee claims remain immutable, approval, deployment and evidence are one-use, and revocation cannot be repaired by record rewrite.",
      "enforcement": "ONCHAIN_AND_INVARIANT",
      "componentIds": ["registry"],
      "evidenceIds": ["registry-lifecycle", "registry-invariants"],
      "invariantIds": ["INV-REGISTRY-MONOTONIC", "INV-FEE-POLICY-IMMUTABLE", "INV-ONE-USE-REGISTRY", "INV-REVOCATION-TERMINAL"]
    },
    {
      "id": "SP-ROLE-SEPARATION",
      "category": "access-control",
      "statement": "Permit and registry authority classes are distinct at construction and permanently lineage-separated; the immutable route is the sole registry writer and wrapper launch caller.",
      "enforcement": "ONCHAIN_AND_INVARIANT",
      "componentIds": ["permitAuthority", "registry", "routeGatedFactory"],
      "evidenceIds": ["permit-authority", "registry-lifecycle", "route-factory"],
      "invariantIds": ["INV-ROLE-SEPARATION"]
    }
  ],
