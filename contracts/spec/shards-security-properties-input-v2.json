  "threatModel": {
    "protectedAssets": [
      "one successful launch graph per GitHub repository lineage",
      "permit, release, route, configuration, wallet and execution bindings",
      "exact CREATE2 token, hook and NFT graph and its runtime identities",
      "permanently locked v4 liquidity and canonical pool identity",
      "ETH fee custody and conservative builder, Programmable and holder accounting",
      "append-only registry identity, revision-one record and terminal revocation state",
      "canonical-block finality evidence and public Website-to-registry identity mapping"
    ],
    "adversaries": [
      "arbitrary EOA or contract without an assigned authority role",
      "applicant attempting post-approval metadata, wallet, salt, calldata or runtime substitution",
      "permit replay across repository, chain, authority, signer epoch, release or route",
      "direct caller of the reviewed factory implementation or wrapper fallback",
      "front-runner attempting foreign-pool or wrong-price initialization",
      "swapper attempting fee bypass, partial-fill overcharge, oversized swap or negative-delta accounting",
      "reentrant recipient or callback during permit consumption, atomic launch or fee payout",
      "operational role holder attempting authority-class collapse or evidence reuse",
      "finalizer supplying stale, noncanonical, shallow or replayed block evidence"
    ],
    "trustedAssumptions": [
      "the exact compiler settings, source closure and normalized artifacts bound by this descriptor are reproduced",
      "the pinned PoolManager and renderer runtime code hashes identify the reviewed dependencies",
      "the EIP-712 signer key and separated governance keys remain uncompromised within their documented powers",
      "the chain implements Cancun EIP-1153 semantics required by ReentrancyGuardTransient",
      "the GitHub technical approval and just-in-time Website intent evidence are produced by their documented offchain authorities",
      "the native blockhash window is used before historical hashes become unavailable"
    ],
    "outOfScope": [
      "consensus failure, validator censorship and canonical-chain failure",
      "market price, liquidity demand, MEV and economic profitability",
      "Website hosting availability and wallet user-interface compromise",
      "loss or malicious use of a governance key within that role's explicit authority",
      "security of any source, artifact, dependency runtime or deployment not exactly bound by this descriptor"
    ]
  },
