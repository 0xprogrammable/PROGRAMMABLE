{
  "schemaVersion": 1,
  "standardId": "launcher.verified-standard.v1",
  "status": "protocol-spike",
  "network": {
    "chainId": 1,
    "settlement": "ethereum-mainnet",
    "deploymentPolicy": "fork-and-sepolia-before-mainnet"
  },
  "token": {
    "implementation": "Uniswap UERC20Factory v2.0",
    "supply": "fixed",
    "wholeTokenSupply": "1000000000",
    "decimals": 18,
    "minting": "single-mint-at-creation",
    "transferTax": false,
    "rebase": false,
    "upgradeable": false
  },
  "launch": {
    "implementation": "Uniswap LiquidityLauncher v3 with Continuous Clearing Auction and LBPStrategy v3.1",
    "atomicCreationAndDistribution": true,
    "directPoolLaunch": false,
    "frontendTransactionPath": "implemented-fail-closed-until-verified-deployment",
    "auctionPolicy": {
      "auctionSupplyPercent": 50,
      "reservedForLpPercent": 50,
      "auctionProceedsToLpPercent": 100,
      "ccaProtocolFeeController": "0x0000000000000000000000000000000000000000",
      "durationBlocks": 1200,
      "startDelayBlocks": 100,
      "claimDelayBlocks": 0,
      "migrationDelayBlocks": 1,
      "emissionSteps": 12,
      "finalBlockSupplyPercent": 30,
      "convexityAlpha": 1.2,
      "floorInput": "minimum-fully-diluted-valuation-in-native-eth",
      "graduation": "auction-supply-clears-at-snapped-floor-price",
      "unsoldTokenRecipient": "launch-creator",
      "migrationDustRecipient": "launch-creator"
    }
  },
  "pool": {
    "protocol": "Uniswap v4",
    "lpFeePips": 3000,
    "tickSpacing": 60,
    "dynamicLpFee": false,
    "initialPosition": "full-range",
    "oneCertifiedHookPerPool": true,
    "positionCustody": {
      "implementation": "Uniswap PositionFeesForwarder",
      "factory": "LockedPositionFeeForwarderFactoryV1",
      "operator": "0x0000000000000000000000000000000000000000",
      "timelockBlockNumber": "uint256.max",
      "liquidityRemoval": false,
      "positionTransfer": false,
      "lpFeeRecipient": "launch-creator",
      "feeCollection": "permissionless-trigger-fixed-recipient"
    }
  },
  "platformFee": {
    "feePips": 1000,
    "denominator": 1000000,
    "percentage": "0.10%",
    "basis": "absolute-unspecified-swap-amount",
    "recipient": "immutable-per-hook",
    "treasury": "0x4957f49620AFf3Adbbe8195a4f633E49cc93376c",
    "collection": "permissionless-trigger-fixed-recipient"
  },
  "hook": {
    "implementation": "PlatformFeeHookV1",
    "upgradeable": false,
    "admin": false,
    "pause": false,
    "mutableParameters": false,
    "boundToOnePool": true,
    "callbackMask": [
      "beforeInitialize",
      "afterSwap",
      "afterSwapReturnDelta"
    ]
  },
  "excludedFromV1": [
    "arbitrary-user-solidity",
    "arbitrary-third-party-hooks",
    "custom-bonding-curves",
    "dynamic-fees",
    "transfer-tax-tokens",
    "rebasing-tokens",
    "proxy-hooks",
    "regulated-rwa-claims",
    "securities-representations"
  ],
  "publicInputs": [
    "token-name",
    "token-symbol",
    "token-description",
    "minimum-fully-diluted-valuation-in-native-eth"
  ],
  "productionApproved": false
}
