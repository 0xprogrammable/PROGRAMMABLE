{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:permit2-launch-witness:1.0.0",
  "title": "Programmable Permit2 launch witness and replay domain",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "permit2Domain", "permit", "launchWitness", "replayProtection", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "permit2Domain": { "$ref": "#/$defs/domain" },
    "permit": { "$ref": "#/$defs/permit" },
    "launchWitness": { "$ref": "#/$defs/witness" },
    "replayProtection": { "$ref": "#/$defs/replay" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes4": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^0x(?:[0-9a-fA-F]{2})*$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "uint": { "type": "string", "minLength": 1, "maxLength": 78, "pattern": "^(?:0|[1-9][0-9]*)$" },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "chainId", "verifyingContract", "domainSeparator"],
      "properties": {
        "name": { "const": "Permit2" },
        "chainId": { "$ref": "#/$defs/uint" },
        "verifyingContract": { "$ref": "#/$defs/address" },
        "domainSeparator": { "$ref": "#/$defs/bytes32" }
      }
    },
    "permit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "owner", "permittedToken", "permittedAmount", "requestedAmount", "spender", "nonce", "signatureDeadline"],
      "properties": {
        "mode": { "const": "permit-witness-transfer-from" },
        "owner": { "$ref": "#/$defs/address" },
        "permittedToken": { "$ref": "#/$defs/address" },
        "permittedAmount": { "$ref": "#/$defs/uint" },
        "requestedAmount": { "$ref": "#/$defs/uint" },
        "spender": { "$ref": "#/$defs/address" },
        "nonce": { "$ref": "#/$defs/uint" },
        "signatureDeadline": { "$ref": "#/$defs/uint" }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witnessTypeString",
        "witnessTypeHash",
        "witnessHash",
        "applicationId",
        "revisionObjectId",
        "action",
        "launchConfigurationSha256",
        "poolKeySha256",
        "hook",
        "router",
        "beneficiary",
        "recipient",
        "refundRecipient",
        "transactionTarget",
        "transactionSelector",
        "transactionDataSha256",
        "nativeValue",
        "payerIntentSha256"
      ],
      "properties": {
        "witnessTypeString": {
          "const": "LaunchWitness witness)LaunchWitness(string applicationId,string revisionObjectId,string action,string launchConfigurationSha256,string poolKeySha256,address hook,address router,address beneficiary,address recipient,address refundRecipient,address transactionTarget,bytes4 transactionSelector,string transactionDataSha256,uint256 nativeValue,string payerIntentSha256)TokenPermissions(address token,uint256 amount)"
        },
        "witnessTypeHash": { "$ref": "#/$defs/bytes32" },
        "witnessHash": { "$ref": "#/$defs/bytes32" },
        "applicationId": { "$ref": "#/$defs/slug" },
        "revisionObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "action": { "enum": ["launch", "configure-launch", "initialize-pool", "provide-liquidity", "fund-launch"] },
        "launchConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "poolKeySha256": { "$ref": "#/$defs/sha256" },
        "hook": { "$ref": "#/$defs/address" },
        "router": { "$ref": "#/$defs/address" },
        "beneficiary": { "$ref": "#/$defs/address" },
        "recipient": { "$ref": "#/$defs/address" },
        "refundRecipient": { "$ref": "#/$defs/address" },
        "transactionTarget": { "$ref": "#/$defs/address" },
        "transactionSelector": { "$ref": "#/$defs/bytes4" },
        "transactionDataSha256": { "$ref": "#/$defs/sha256" },
        "nativeValue": { "$ref": "#/$defs/uint" },
        "payerIntentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainBound",
        "permit2Bound",
        "ownerBound",
        "spenderBound",
        "nonceBound",
        "deadlineBound",
        "witnessBound",
        "singleUseNonce",
        "crossChainReplayRejected",
        "crossContractReplayRejected",
        "crossLaunchReplayRejected",
        "digest"
      ],
      "properties": {
        "chainBound": { "const": true },
        "permit2Bound": { "const": true },
        "ownerBound": { "const": true },
        "spenderBound": { "const": true },
        "nonceBound": { "const": true },
        "deadlineBound": { "const": true },
        "witnessBound": { "const": true },
        "singleUseNonce": { "const": true },
        "crossChainReplayRejected": { "const": true },
        "crossContractReplayRejected": { "const": true },
        "crossLaunchReplayRejected": { "const": true },
        "digest": { "$ref": "#/$defs/bytes32" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "signer", "bytes"],
      "properties": {
        "scheme": { "enum": ["eip712-eoa", "erc1271"] },
        "signer": { "$ref": "#/$defs/address" },
        "bytes": { "type": "string", "minLength": 4, "maxLength": 4098, "pattern": "^0x(?:[0-9a-fA-F]{2})*$" }
      }
    }
  }
}
