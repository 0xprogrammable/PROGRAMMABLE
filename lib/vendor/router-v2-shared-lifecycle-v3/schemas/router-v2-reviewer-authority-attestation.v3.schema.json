{
  "$id": "https://programmable.market/schemas/router-v2-reviewer-authority-attestation.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "V3.0.0 is immutable UNDEPLOYED/DENY. router-v2-reviewer-authority-attestation.v3.schema.json is structural documentation only and admits no artifact; a separately frozen deployment-bound successor must publish a new admitting schema.",
  "not": {},
  "properties": {
    "attestationHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "attestationVersion": {
      "const": "3.0.0"
    },
    "builderEvidenceHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractApplicantIdHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "contractArtifactBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractBuilderEvidenceHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "contractPlanHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "contractReviewerAttestationHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "decision": {
      "enum": [
        "APPROVED",
        "DENIED"
      ]
    },
    "durableForExactRevision": {
      "const": true
    },
    "issuedAt": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "legacyAttestation": {
      "$ref": "https://programmable.market/schemas/programmable.router-v2-reviewer-authority-attestation.v2.schema.json"
    },
    "legacyAttestationHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "planHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "policyEpoch": {
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "policyEpochHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "policyHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "profileDescriptorHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "reviewControl": {
      "additionalProperties": false,
      "properties": {
        "reviewGeneration": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "reviewGenerationHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "reviewGeneration",
        "reviewGenerationHash"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "programmable.router-v2-reviewer-authority-attestation.v3"
    },
    "securityControlHeadHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "securityEpoch": {
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "securityEpochHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "attestationHash",
    "attestationVersion",
    "builderEvidenceHash",
    "contractApplicantIdHash",
    "contractArtifactBindingHash",
    "contractBuilderEvidenceHash",
    "contractPlanHash",
    "contractReviewerAttestationHash",
    "decision",
    "durableForExactRevision",
    "issuedAt",
    "legacyAttestation",
    "legacyAttestationHash",
    "planHash",
    "policyEpoch",
    "policyEpochHash",
    "policyHash",
    "profileDescriptorHash",
    "reviewControl",
    "schemaVersion",
    "securityControlHeadHash",
    "securityEpoch",
    "securityEpochHash"
  ],
  "title": "router-v2-reviewer-authority-attestation.v3",
  "type": "object"
}
