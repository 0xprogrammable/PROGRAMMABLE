{
  "$id": "https://programmable.market/schemas/router-v2-builder-evidence-commitment.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "V3.0.0 is immutable UNDEPLOYED/DENY. router-v2-builder-evidence-commitment.v3.schema.json is structural documentation only and admits no artifact; a separately frozen deployment-bound successor must publish a new admitting schema.",
  "not": {},
  "properties": {
    "contractArtifactBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractBuilderEvidenceHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "contractPlanHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "evidenceHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evidenceVersion": {
      "const": "3.0.0"
    },
    "issuedAt": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "legacyEvidence": {
      "$ref": "https://programmable.market/schemas/programmable.router-v2-builder-evidence-commitment.v2.schema.json"
    },
    "legacyEvidenceHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "planHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "profileDescriptorHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "programmable.router-v2-builder-evidence-commitment.v3"
    },
    "sourceReferents": {
      "$ref": "https://programmable.market/schemas/router-v2-source-identity-referents.v3.schema.json"
    }
  },
  "required": [
    "contractArtifactBindingHash",
    "contractBuilderEvidenceHash",
    "contractPlanHash",
    "evidenceHash",
    "evidenceVersion",
    "issuedAt",
    "legacyEvidence",
    "legacyEvidenceHash",
    "planHash",
    "profileDescriptorHash",
    "schemaVersion",
    "sourceReferents"
  ],
  "title": "router-v2-builder-evidence-commitment.v3",
  "type": "object"
}
