{
  "$id": "https://programmable.market/schemas/router-v2-finality-indexing-receipt.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "V3.0.0 is immutable UNDEPLOYED/DENY. router-v2-finality-indexing-receipt.v3.schema.json is structural documentation only and admits no artifact; a separately frozen deployment-bound successor must publish a new admitting schema.",
  "not": {},
  "properties": {
    "authorityGrantArtifactHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "canonicalLaunchReceiptHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractReceipt": {
      "additionalProperties": false,
      "properties": {
        "evidenceHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "finalityIndexingReceiptHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "launchGrantDigest": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "nextStatus": {
          "enum": [
            3,
            4,
            5
          ]
        },
        "previousFinalityIndexingReceiptHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "receiptCoreHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "stampLaunchId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "evidenceHash",
        "finalityIndexingReceiptHash",
        "launchGrantDigest",
        "nextStatus",
        "previousFinalityIndexingReceiptHash",
        "receiptCoreHash",
        "stampLaunchId"
      ],
      "type": "object"
    },
    "finalityAuthorityBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "indexingAuthorityBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "primaryRpcObservationSha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "receiptHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "receiptVersion": {
      "const": "3.0.0"
    },
    "schemaVersion": {
      "const": "programmable.router-v2-finality-indexing-receipt.v3"
    },
    "secondaryRpcObservationSha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "authorityGrantArtifactHash",
    "canonicalLaunchReceiptHash",
    "contractReceipt",
    "finalityAuthorityBindingHash",
    "indexingAuthorityBindingHash",
    "primaryRpcObservationSha256",
    "receiptHash",
    "receiptVersion",
    "schemaVersion",
    "secondaryRpcObservationSha256"
  ],
  "title": "router-v2-finality-indexing-receipt.v3",
  "type": "object"
}
