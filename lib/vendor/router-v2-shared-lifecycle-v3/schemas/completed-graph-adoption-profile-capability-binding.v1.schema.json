    "profileCapabilityHash",
    "profileDescriptorHash",
    "profileKey",
    "profileStatus",
    "registrationBlockHash",
    "registrationBlockNumber",
    "registrationTransactionHash",
    "requiredIdentityMask",
    "reviewControl",
    "routeSchemaHash",
    "runtimeAuthorityBindingHash",
    "schemaVersion",
    "stateVerifierBinding"
