{
  "$id": "https://programmable.market/schemas/router-v2-launch-grant.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "V3.0.0 is immutable UNDEPLOYED/DENY. router-v2-launch-grant.v3.schema.json is structural documentation only and admits no artifact; a separately frozen deployment-bound successor must publish a new admitting schema.",
  "not": {},
  "properties": {
    "authorityGrantArtifactHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "builderEvidenceHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractArtifactBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractDeploymentBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractGrantBinding": {
      "$ref": "https://programmable.market/schemas/router-v2-completed-graph-launch-grant-digest-binding.v1.schema.json"
    },
    "expiresAt": {
      "type": "null"
    },
    "grantHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "grantVersion": {
      "const": "3.0.0"
    },
    "identitySet": {
      "additionalProperties": false,
      "properties": {
        "antiReplayNonce": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "sourceLaunchId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "stampLaunchId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "antiReplayNonce",
        "sourceLaunchId",
        "stampLaunchId"
      ],
      "type": "object"
    },
    "issuedAt": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "noDefaultExpiry": {
      "const": true
    },
    "planHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "profileCapabilityBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "profileDescriptorHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "reviewerAttestationHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "programmable.router-v2-launch-grant.v3"
    },
    "sourceReferents": {
      "$ref": "https://programmable.market/schemas/router-v2-source-identity-referents.v3.schema.json"
    },
    "stateAtIssuance": {
      "const": "ACTIVE"
    }
  },
  "required": [
    "authorityGrantArtifactHash",
    "builderEvidenceHash",
    "contractArtifactBindingHash",
    "contractDeploymentBindingHash",
    "contractGrantBinding",
    "expiresAt",
    "grantHash",
    "grantVersion",
    "identitySet",
    "issuedAt",
    "noDefaultExpiry",
    "planHash",
    "profileCapabilityBindingHash",
    "profileDescriptorHash",
    "reviewerAttestationHash",
    "schemaVersion",
    "sourceReferents",
    "stateAtIssuance"
  ],
  "title": "router-v2-launch-grant.v3",
  "type": "object"
}
