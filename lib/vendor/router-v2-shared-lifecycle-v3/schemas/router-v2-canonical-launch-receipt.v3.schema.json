{
  "$id": "https://programmable.market/schemas/router-v2-canonical-launch-receipt.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "V3.0.0 is immutable UNDEPLOYED/DENY. router-v2-canonical-launch-receipt.v3.schema.json is structural documentation only and admits no artifact; a separately frozen deployment-bound successor must publish a new admitting schema.",
  "not": {},
  "properties": {
    "authorityGrantArtifactHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractArtifactBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractDeploymentBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractReceiptCore": {
      "additionalProperties": false,
      "properties": {
        "adoptionRequestHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "contractPlanHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "executionCurrentnessDigest": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "launchGrantDigest": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "launchGrantHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "profileCapabilityHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "receiptCoreHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "sourceLaunchId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "stampLaunchId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "adoptionRequestHash",
        "contractPlanHash",
        "executionCurrentnessDigest",
        "launchGrantDigest",
        "launchGrantHash",
        "profileCapabilityHash",
        "receiptCoreHash",
        "sourceLaunchId",
        "stampLaunchId"
      ],
      "type": "object"
    },
    "profileCapabilityBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "receiptHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "receiptVersion": {
      "const": "3.0.0"
    },
    "schemaVersion": {
      "const": "programmable.router-v2-canonical-launch-receipt.v3"
    },
    "sourceReferents": {
      "$ref": "https://programmable.market/schemas/router-v2-source-identity-referents.v3.schema.json"
    },
    "transactionLineage": {
      "additionalProperties": false,
      "properties": {
        "blockHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        "blockNumber": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "chainId": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "logIndex": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "primaryFinalityEvidenceSha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "registry": {
          "pattern": "^0x[0-9a-f]{40}$",
          "type": "string"
        },
        "secondaryFinalityEvidenceSha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "transactionHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "blockHash",
        "blockNumber",
        "chainId",
        "logIndex",
        "primaryFinalityEvidenceSha256",
        "registry",
        "secondaryFinalityEvidenceSha256",
        "transactionHash"
      ],
      "type": "object"
    }
  },
  "required": [
    "authorityGrantArtifactHash",
    "contractArtifactBindingHash",
    "contractDeploymentBindingHash",
    "contractReceiptCore",
    "profileCapabilityBindingHash",
    "receiptHash",
    "receiptVersion",
    "schemaVersion",
    "sourceReferents",
    "transactionLineage"
  ],
  "title": "router-v2-canonical-launch-receipt.v3",
  "type": "object"
}
