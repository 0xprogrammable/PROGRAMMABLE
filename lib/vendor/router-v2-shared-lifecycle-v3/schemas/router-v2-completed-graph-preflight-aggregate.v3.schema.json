{
  "$id": "https://programmable.market/schemas/router-v2-completed-graph-preflight-aggregate.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "V3.0.0 is immutable UNDEPLOYED/DENY. router-v2-completed-graph-preflight-aggregate.v3.schema.json is structural documentation only and admits no artifact; a separately frozen deployment-bound successor must publish a new admitting schema.",
  "not": {},
  "properties": {
    "artifactHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "candidateCurrentnessDiagnostic": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "candidateCurrentnessDigest": {
              "pattern": "^0x[0-9a-f]{64}$",
              "type": "string"
            },
            "diagnosticArtifactSha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "candidateCurrentnessDigest",
            "diagnosticArtifactSha256"
          ],
          "type": "object"
        }
      ]
    },
    "componentCount": {
      "maximum": 24,
      "minimum": 1,
      "type": "integer"
    },
    "contractAggregateHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "globalReadbackHeadHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "normalizedReadbackHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "orderedComponentLeavesHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "primaryProviderReadbackSha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "providerIndependenceEvidenceSha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "programmable.router-v2-completed-graph-preflight-aggregate.v3"
    },
    "secondaryProviderReadbackSha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "signedAggregateHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "artifactHash",
    "candidateCurrentnessDiagnostic",
    "componentCount",
    "contractAggregateHash",
    "globalReadbackHeadHash",
    "normalizedReadbackHash",
    "orderedComponentLeavesHash",
    "primaryProviderReadbackSha256",
    "providerIndependenceEvidenceSha256",
    "schemaVersion",
    "secondaryProviderReadbackSha256",
    "signedAggregateHash"
  ],
  "title": "router-v2-completed-graph-preflight-aggregate.v3",
  "type": "object"
}
