        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "programmable.completed-graph-adoption-contract-deployment-binding.v1"
    },
    "serviceDeploymentBindingArtifactSha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "serviceDeploymentBindingHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "sourceVerificationReceipts": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 2000,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "validator": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "validatorRuntimeCodeHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "baseRuntimeAuthorityBindingHash",
    "chainId",
    "codec",
    "codecRuntimeCodeHash",
    "creationTransactions",
    "dependencyBehaviorEvidenceHash",
    "deploymentBindingHash",
    "finalityAuthority",
    "finalityAuthorityRuntimeCodeHash",
    "finalityReceipts",
    "governance",
    "governanceRuntimeCodeHash",
    "indexerAuthority",
    "indexerAuthorityRuntimeCodeHash",
    "preflight",
    "preflightRuntimeCodeHash",
    "registry",
    "registryRuntimeCodeHash",
    "reviewerAuthority",
    "reviewerAuthorityRuntimeCodeHash",
    "router",
    "runtimeSpecializations",
    "schemaVersion",
    "serviceDeploymentBindingArtifactSha256",
    "serviceDeploymentBindingHash",
    "sourceVerificationReceipts",
    "validator",
    "validatorRuntimeCodeHash"
  ],
  "title": "completed-graph-adoption-contract-deployment-binding.v1",
  "type": "object"
}
