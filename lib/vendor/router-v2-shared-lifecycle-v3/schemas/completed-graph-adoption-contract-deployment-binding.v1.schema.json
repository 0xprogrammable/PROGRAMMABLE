{
  "$id": "https://programmable.market/schemas/completed-graph-adoption-contract-deployment-binding.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "V3.0.0 is immutable UNDEPLOYED/DENY. completed-graph-adoption-contract-deployment-binding.v1.schema.json is structural documentation only and admits no artifact; a separately frozen deployment-bound successor must publish a new admitting schema.",
  "not": {},
  "properties": {
    "baseRuntimeAuthorityBindingHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "chainId": {
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "codec": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "codecRuntimeCodeHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "creationTransactions": {
      "items": {
        "pattern": "^0x[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 2000,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "dependencyBehaviorEvidenceHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "deploymentBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "finalityAuthority": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "finalityAuthorityRuntimeCodeHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "finalityReceipts": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 2000,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "governance": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "governanceRuntimeCodeHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "indexerAuthority": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "indexerAuthorityRuntimeCodeHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "preflight": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "preflightRuntimeCodeHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "registry": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "registryRuntimeCodeHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "reviewerAuthority": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "reviewerAuthorityRuntimeCodeHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "router": {
      "pattern": "^0x[0-9a-f]{40}$",
      "type": "string"
    },
    "runtimeSpecializations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "constructorArgumentsArtifactSha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "immutableReferencesArtifactSha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "liveRuntimeCodeHash": {
            "pattern": "^0x[0-9a-f]{64}$",
            "type": "string"
          },
          "name": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "sourceVerificationReceiptSha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "specializationReproductionReceiptSha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "specializedRuntimeBytes": {
            "maximum": 24576,
            "minimum": 1,
            "type": "integer"
          },
          "specializedRuntimeKeccak256": {
            "pattern": "^0x[0-9a-f]{64}$",
            "type": "string"
          },
          "specializedRuntimeSha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "constructorArgumentsArtifactSha256",
          "immutableReferencesArtifactSha256",
          "liveRuntimeCodeHash",
          "name",
          "sourceVerificationReceiptSha256",
          "specializationReproductionReceiptSha256",
          "specializedRuntimeBytes",
          "specializedRuntimeKeccak256",
          "specializedRuntimeSha256"
