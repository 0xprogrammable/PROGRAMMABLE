{
  "$id": "https://programmable.market/schemas/router-v2-applicant-launch-plan.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "V3.0.0 is immutable UNDEPLOYED/DENY. router-v2-applicant-launch-plan.v3.schema.json is structural documentation only and admits no artifact; a separately frozen deployment-bound successor must publish a new admitting schema.",
  "not": {},
  "properties": {
    "contractArtifactBindingHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "contractPlan": {
      "$ref": "https://programmable.market/schemas/router-v2-completed-graph-plan-contract.v1.schema.json"
    },
    "contractPlanHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "issuedAt": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "legacyMigrationRule": {
      "const": "V2_ARCHIVAL_ONLY_EXPLICIT_V3_CONTRACT_FIELDS_CONTROL"
    },
    "legacyPlan": {
      "$ref": "https://programmable.market/schemas/programmable.router-v2-applicant-launch-plan.v2.schema.json"
    },
    "legacyPlanHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "planHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "planVersion": {
      "const": "3.0.0"
    },
    "profileDescriptorHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "programmable.router-v2-applicant-launch-plan.v3"
    },
    "sourceLaunchId": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "sourceReferents": {
      "$ref": "https://programmable.market/schemas/router-v2-source-identity-referents.v3.schema.json"
    }
  },
  "required": [
    "contractArtifactBindingHash",
    "contractPlan",
    "contractPlanHash",
    "issuedAt",
    "legacyMigrationRule",
    "legacyPlan",
    "legacyPlanHash",
    "planHash",
    "planVersion",
    "profileDescriptorHash",
    "schemaVersion",
    "sourceLaunchId",
    "sourceReferents"
  ],
  "title": "router-v2-applicant-launch-plan.v3",
  "type": "object"
}
