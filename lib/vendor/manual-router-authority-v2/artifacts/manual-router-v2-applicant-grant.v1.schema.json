{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-applicant-grant:1",
  "title": "Programmable manual Router V2 applicant grant",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptanceSubjectHash",
    "applicantAcceptanceClaimSha256",
    "applicantAcceptanceRecordHash",
    "applicantActionSelector",
    "capabilityHash",
    "chainId",
    "compiledRouteVerificationHash",
    "currentAcceptanceHash",
    "executionModePolicy",
    "expectedConfigurationHash",
    "expectedPoolId",
    "expectedResultHash",
    "expiresAtEpochSeconds",
    "grantHash",
    "issuedAtEpochSeconds",
    "launchId",
    "launchIdentityHash",
    "launchWallet",
    "permitNonce",
    "releaseAttestationHash",
    "releaseStatementHash",
    "releaseVerificationHash",
    "revenuePolicyHash",
    "routePayloadHash",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.nested-factory-applicant-grant.v1"
    },
    "chainId": {
      "const": "1"
    },
    "issuedAtEpochSeconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "expiresAtEpochSeconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "releaseAttestationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "releaseVerificationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "releaseStatementHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acceptanceSubjectHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "currentAcceptanceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "applicantAcceptanceClaimSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "applicantAcceptanceRecordHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchIdentityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "launchWallet": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "permitNonce": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "routePayloadHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "expectedResultHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "compiledRouteVerificationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revenuePolicyHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "expectedPoolId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "expectedConfigurationHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "applicantActionSelector": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{8}$"
    },
    "executionModePolicy": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": false,
      "prefixItems": [
        {
          "const": "EXACT_EXISTING_LAUNCH_ADOPTED"
        },
        {
          "const": "EXACT_FACTORY_LAUNCH_EXECUTED"
        }
      ]
    },
    "grantHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
