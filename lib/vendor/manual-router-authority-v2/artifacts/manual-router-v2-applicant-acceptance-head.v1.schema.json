{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-applicant-acceptance-head:1",
  "title": "Programmable manual Router V2 applicant acceptance CAS head",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptanceHash",
    "acceptanceSubjectHash",
    "acceptedAt",
    "applicantAcceptanceRecordHash",
    "authenticatedGithubUserId",
    "claimSha256",
    "previousAcceptanceHash",
    "revision",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.nested-factory-applicant-acceptance-head.v1"
    },
    "acceptanceSubjectHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "previousAcceptanceHash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "claimSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "applicantAcceptanceRecordHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authenticatedGithubUserId": {
      "const": "155705664"
    },
    "acceptedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "acceptanceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
