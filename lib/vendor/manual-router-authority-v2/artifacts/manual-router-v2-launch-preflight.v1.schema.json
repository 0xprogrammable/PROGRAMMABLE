{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-launch-preflight:1",
  "title": "Programmable manual Router V2 launch preflight",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptanceSubjectHash",
    "browserAction",
    "bufferedGasLimit",
    "capabilityHash",
    "chainId",
    "currentAcceptanceHash",
    "currentnessEvidenceHash",
    "executionMode",
    "executionModePolicy",
    "expiresAtEpochSeconds",
    "gasEvidenceHash",
    "grantHash",
    "issuedAtEpochSeconds",
    "launchId",
    "mainnetTransactionGasLimit",
    "maximumLiveGasEstimate",
    "permitNonce",
    "preflightHash",
    "releaseAttestationHash",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.nested-factory-launch-preflight.v1"
    },
    "chainId": {
      "const": "1"
    },
    "issuedAtEpochSeconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "expiresAtEpochSeconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "grantHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "releaseAttestationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acceptanceSubjectHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "currentAcceptanceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "permitNonce": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "executionMode": {
      "enum": [
        "EXACT_FACTORY_LAUNCH_EXECUTED",
        "EXACT_EXISTING_LAUNCH_ADOPTED"
      ]
    },
    "executionModePolicy": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": false,
      "prefixItems": [
        {
          "const": "EXACT_EXISTING_LAUNCH_ADOPTED"
        },
        {
          "const": "EXACT_FACTORY_LAUNCH_EXECUTED"
        }
      ]
    },
    "browserAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionHash",
        "data",
        "from",
        "to",
        "value"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "to": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "data": {
          "type": "string",
          "pattern": "^0x([0-9a-f]{2})*$",
          "maxLength": 2097154
        },
        "value": {
          "type": "string",
          "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
        },
        "actionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "currentnessEvidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gasEvidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "maximumLiveGasEstimate": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "bufferedGasLimit": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "mainnetTransactionGasLimit": {
      "const": "16777216"
    },
    "preflightHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
