{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-existing-launch-adoption-receipt:1",
  "title": "Programmable manual Router V2 exact existing launch adoption receipt",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archiveEvidenceState",
    "blockHash",
    "blockNumber",
    "capabilityHash",
    "chainId",
    "configurationHash",
    "executionMode",
    "finalizedAnchorHash",
    "launchIdentityHash",
    "poolId",
    "poolInitializeLogHash",
    "poolInitializeLogIndex",
    "predeploymentReceiptHash",
    "receiptHash",
    "rpcBindingHash",
    "schemaVersion",
    "shardLaunchedLogHash",
    "shardLaunchedLogIndex",
    "transactionFrom",
    "transactionHash",
    "transactionIndex",
    "transactionInputBytes",
    "transactionInputHash",
    "transactionTo",
    "transactionValue"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.nested-factory-existing-launch-adoption-receipt.v1"
    },
    "chainId": {
      "const": "1"
    },
    "capabilityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchIdentityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predeploymentReceiptHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executionMode": {
      "const": "EXACT_EXISTING_LAUNCH_ADOPTED"
    },
    "transactionHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "transactionFrom": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "transactionTo": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "transactionInputBytes": {
      "const": 27140
    },
    "transactionInputHash": {
      "const": "0x39d08baf1cdececc5829853fd1274547c2e8260779d0c227ec30dc44daf1ae89"
    },
    "transactionValue": {
      "const": "0"
    },
    "blockNumber": {
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
    },
    "blockHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "transactionIndex": {
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
    },
    "finalizedAnchorHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rpcBindingHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "shardLaunchedLogIndex": {
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
    },
    "shardLaunchedLogHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "poolInitializeLogIndex": {
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
    },
    "poolInitializeLogHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configurationHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "poolId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "archiveEvidenceState": {
      "const": "matched-finalized-canonical-exact-direct-factory-launch"
    },
    "receiptHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
