{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-currentness-evidence:1",
  "title": "Programmable manual Router V2 live currentness evidence",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adoptionReceiptHash",
    "authorityStates",
    "capabilityHash",
    "chainClock",
    "components",
    "deploymentPlanHash",
    "deploymentTargetState",
    "evidenceHash",
    "executionMode",
    "factoryGetterState",
    "finalizedAnchor",
    "launchIdentityHash",
    "observedStartingState",
    "poolId",
    "poolState",
    "poolStateSlot",
    "predeploymentReceiptHash",
    "rpcBindingHash",
    "runtimeState",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.nested-factory-currentness-evidence.v1"
    },
    "capabilityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchIdentityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "deploymentPlanHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predeploymentReceiptHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "adoptionReceiptHash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "executionMode": {
      "enum": [
        "EXACT_FACTORY_LAUNCH_EXECUTED",
        "EXACT_EXISTING_LAUNCH_ADOPTED"
      ]
    },
    "finalizedAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorHash",
        "blockHash",
        "blockNumber",
        "chainId",
        "providerIds",
        "schemaVersion",
        "timestamp"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.router-common-finalized-anchor.v1"
        },
        "chainId": {
          "const": "1"
        },
        "blockNumber": {
          "type": "string",
          "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "providerIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "anchorHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "chainClock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumTimestamp",
        "minimumTimestamp",
        "providerTimestamps"
      ],
      "properties": {
        "minimumTimestamp": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "maximumTimestamp": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "providerTimestamps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "rpcBindingHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authorityStates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "authorityConfigurationSha256",
          "role",
          "safeNonce"
        ],
        "properties": {
          "role": {
            "enum": [
              "capability-admin",
              "permit-authority"
            ]
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "authorityConfigurationSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "safeNonce": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "poolId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "poolStateSlot": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "hook",
              "nft",
              "token"
            ]
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        }
      }
    },
    "runtimeState": {
      "const": "matched-finalized-and-latest"
    },
    "observedStartingState": {
      "enum": [
        "exact-predeployed-pair",
        "exact-existing-canonical-launch"
      ]
    },
    "factoryGetterState": {
      "const": "matched-finalized-and-latest"
    },
    "deploymentTargetState": {
      "enum": [
        "factory-renderer-exact-children-empty-finalized-and-latest",
        "factory-renderer-children-runtimes-config-exact-finalized-and-latest"
      ]
    },
    "poolState": {
      "enum": [
        "uninitialized-finalized-and-latest",
        "initialized-exact-pool-finalized-and-latest"
      ]
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
