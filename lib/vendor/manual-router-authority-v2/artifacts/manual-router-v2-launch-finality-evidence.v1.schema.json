{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-launch-finality-evidence:1",
  "title": "Programmable manual Router V2 launch finality evidence",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applicantGrantHash",
    "blockHash",
    "blockNumber",
    "blockTimestamp",
    "capabilityHash",
    "chainId",
    "componentRuntimeState",
    "evidenceHash",
    "executionMode",
    "executionModePolicy",
    "finalityState",
    "finalizedAnchorHash",
    "launchId",
    "launchIdentityHash",
    "launchPreflightHash",
    "launchStampedLogHash",
    "launchStampedLogIndex",
    "permitDigest",
    "permitReservationHash",
    "routeStampedLogHash",
    "routeStampedLogIndex",
    "routerReadbackState",
    "rpcBindingHash",
    "schemaVersion",
    "stampHash",
    "stampRecordHash",
    "terminalStatus",
    "transactionFrom",
    "transactionHash",
    "transactionInputBytes",
    "transactionInputHash",
    "transactionNonce",
    "transactionTo",
    "transactionValue"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.nested-factory-launch-finality-evidence.v1"
    },
    "chainId": {
      "const": "1"
    },
    "terminalStatus": {
      "const": "FINALIZED_SUCCESS"
    },
    "executionMode": {
      "enum": [
        "EXACT_FACTORY_LAUNCH_EXECUTED",
        "EXACT_EXISTING_LAUNCH_ADOPTED"
      ]
    },
    "executionModePolicy": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": false,
      "prefixItems": [
        {
          "const": "EXACT_EXISTING_LAUNCH_ADOPTED"
        },
        {
          "const": "EXACT_FACTORY_LAUNCH_EXECUTED"
        }
      ]
    },
    "transactionHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "transactionNonce": {
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
    },
    "transactionFrom": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "transactionTo": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "transactionInputBytes": {
      "type": "integer",
      "minimum": 4,
      "maximum": 1048576
    },
    "transactionInputHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "transactionValue": {
      "const": "0"
    },
    "blockNumber": {
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
    },
    "blockHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "blockTimestamp": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "finalizedAnchorHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rpcBindingHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchIdentityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "applicantGrantHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchPreflightHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "permitReservationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "permitDigest": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "stampHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "routeStampedLogIndex": {
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
    },
    "routeStampedLogHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchStampedLogIndex": {
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
    },
    "launchStampedLogHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stampRecordHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "routerReadbackState": {
      "const": "exact-stamp-indices-nonce-digest-matched-finalized-and-latest"
    },
    "componentRuntimeState": {
      "const": "exact-finalized-and-latest"
    },
    "finalityState": {
      "const": "matched-finalized-canonical-router-transaction"
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
