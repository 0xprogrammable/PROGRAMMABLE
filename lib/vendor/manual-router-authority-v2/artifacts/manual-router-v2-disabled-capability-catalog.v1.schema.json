{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-disabled-capability-catalog:1",
  "title": "Programmable manual Router V2 disabled capability catalog",
  "$comment": "Closed structural gate for an explicitly disabled release. The portable code verifier remains mandatory and no signature request may be derived from this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogHash",
    "catalogVersion",
    "entries",
    "schemaVersion"
  ],
  "properties": {
    "catalogHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "catalogVersion": {
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": false,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activation",
            "capabilityHash",
            "capabilityId",
            "catalogVersion",
            "chainId",
            "manifestHash",
            "planSchemaId",
            "poolManager",
            "poolManagerRuntimeCodeHash",
            "profile",
            "profileSha256",
            "revenuePolicyHash",
            "routeId",
            "routeVersion",
            "schemaVersion",
            "sourceRevisionHash",
            "state"
          ],
          "properties": {
            "activation": {
              "type": "null"
            },
            "capabilityHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "capabilityId": {
              "const": "exact-shards-nested-factory@1.0.0"
            },
            "catalogVersion": {
              "const": "1.0.0"
            },
            "chainId": {
              "const": "1"
            },
            "manifestHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "planSchemaId": {
              "const": "urn:programmable:reviewed-route-plan:1.0.0"
            },
            "poolManager": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "poolManagerRuntimeCodeHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "profile": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profileId",
                "profileIdHash",
                "profileKey",
                "profileVersion",
                "profileVersionHash"
              ],
              "properties": {
                "profileId": {
                  "const": "exact-shards-nested-factory"
                },
                "profileIdHash": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "profileKey": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "profileVersion": {
                  "const": "1.0.0"
                },
                "profileVersionHash": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                }
              }
            },
            "profileSha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "revenuePolicyHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "routeId": {
              "const": "nested-factory"
            },
            "routeVersion": {
              "const": "1.0.0"
            },
            "schemaVersion": {
              "const": "programmable.nested-factory-capability.v1"
            },
            "sourceRevisionHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "state": {
              "const": "disabled"
            }
          }
        }
      ]
    },
    "schemaVersion": {
      "const": "programmable.nested-factory-capability-catalog.v1"
    }
  }
}
