{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-predeployment-receipt:1",
  "title": "Programmable manual Router V2 exact factory predeployment receipt",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blockHash",
    "blockNumber",
    "chainId",
    "deployedState",
    "deploymentBytesVerificationHash",
    "deploymentPlanHash",
    "dualRpcReceiptState",
    "finalizedAnchorHash",
    "observedTransactionFrom",
    "plannedTransactionFrom",
    "receiptHash",
    "receiptStatus",
    "rpcBindingHash",
    "schemaVersion",
    "transactionHash",
    "transactionInputBytes",
    "transactionInputHash",
    "transactionTo",
    "transactionValue"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.nested-factory-predeployment-receipt.v1"
    },
    "chainId": {
      "const": "1"
    },
    "deploymentPlanHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "deploymentBytesVerificationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "transactionHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "plannedTransactionFrom": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "observedTransactionFrom": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "transactionTo": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "transactionInputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "transactionInputHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "transactionValue": {
      "const": "0"
    },
    "blockNumber": {
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$"
    },
    "blockHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "finalizedAnchorHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rpcBindingHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receiptStatus": {
      "const": "success"
    },
    "dualRpcReceiptState": {
      "const": "matched-finalized"
    },
    "deployedState": {
      "const": "factory-renderer-exact-children-empty-pool-uninitialized-at-finalized-deployment-block"
    },
    "receiptHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
