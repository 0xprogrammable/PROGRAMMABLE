{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-gas-evidence:1",
  "title": "Programmable manual Router V2 live gas evidence",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bufferDenominator",
    "bufferNumerator",
    "bufferedGasLimit",
    "capabilityHash",
    "chainId",
    "currentnessEvidenceHash",
    "evidenceHash",
    "executionMode",
    "finalizedAnchorHash",
    "launchIdentityHash",
    "launchWallet",
    "mainnetTransactionGasLimit",
    "maximumEstimate",
    "predeploymentReceiptHash",
    "providerEstimates",
    "router",
    "rpcBindingHash",
    "schemaVersion",
    "transactionCalldataBytes",
    "transactionCalldataHash",
    "transactionValue",
    "withinMainnetTransactionGasLimit"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.nested-factory-gas-evidence.v1"
    },
    "chainId": {
      "const": "1"
    },
    "capabilityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchIdentityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predeploymentReceiptHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "currentnessEvidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "finalizedAnchorHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rpcBindingHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "router": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "launchWallet": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "transactionCalldataBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "transactionCalldataHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "transactionValue": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "providerEstimates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gas",
          "providerId"
        ],
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "gas": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "maximumEstimate": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "bufferNumerator": {
      "const": "120"
    },
    "bufferDenominator": {
      "const": "100"
    },
    "bufferedGasLimit": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "mainnetTransactionGasLimit": {
      "const": "16777216"
    },
    "executionMode": {
      "enum": [
        "EXACT_FACTORY_LAUNCH_EXECUTED",
        "EXACT_EXISTING_LAUNCH_ADOPTED"
      ]
    },
    "withinMainnetTransactionGasLimit": {
      "const": true
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
