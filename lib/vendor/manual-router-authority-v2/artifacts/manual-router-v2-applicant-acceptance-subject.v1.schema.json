{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-applicant-acceptance-subject:1",
  "title": "Programmable manual Router V2 applicant acceptance subject",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptanceSubjectHash",
    "applicantGithubUserId",
    "reviewedRequest",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.application-acceptance-subject.v1"
    },
    "applicantGithubUserId": {
      "const": 155705664
    },
    "reviewedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationManifestSha256",
        "path"
      ],
      "properties": {
        "path": {
          "const": "submissions/requests/1329073878-shards-v1.json"
        },
        "applicationManifestSha256": {
          "const": "sha256:e069926d380e56bee001dd7cfeda591db56164b1acf7478b478dd62a6e119ec2"
        }
      }
    },
    "acceptanceSubjectHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
