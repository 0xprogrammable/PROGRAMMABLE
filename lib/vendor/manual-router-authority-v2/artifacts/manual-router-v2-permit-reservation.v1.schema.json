{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-v2-permit-reservation:1",
  "title": "Programmable manual Router V2 permit reservation",
  "$comment": "Closed structural and size gate only. The portable V2 code verifier must re-derive every hash, signature, release, acceptance CAS, currentness, calldata and gas-policy binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applicantAcceptanceRecordHash",
    "applicantGrantHash",
    "capabilityHash",
    "compiledRouteVerificationHash",
    "currentAcceptanceHash",
    "currentnessEvidenceHash",
    "deadline",
    "executionModePolicy",
    "gasEvidenceHash",
    "launchId",
    "launchPreflightHash",
    "ownerSignatureRequest",
    "permitDigest",
    "permitNonce",
    "previousReservationHash",
    "reservationHash",
    "revision",
    "router",
    "schemaVersion",
    "validAfter"
  ],
  "properties": {
    "schemaVersion": {
      "const": "programmable.nested-factory-permit-reservation.v1"
    },
    "launchId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "previousReservationHash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "router": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "permitNonce": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "permitDigest": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "executionModePolicy": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": false,
      "prefixItems": [
        {
          "const": "EXACT_EXISTING_LAUNCH_ADOPTED"
        },
        {
          "const": "EXACT_FACTORY_LAUNCH_EXECUTED"
        }
      ]
    },
    "validAfter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "deadline": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "capabilityHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compiledRouteVerificationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "currentnessEvidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gasEvidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "applicantGrantHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launchPreflightHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "currentAcceptanceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "applicantAcceptanceRecordHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ownerSignatureRequest": {
      "type": "null"
    },
    "reservationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
