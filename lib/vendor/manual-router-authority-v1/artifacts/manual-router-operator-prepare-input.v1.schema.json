{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:manual-router-operator-prepare-input:1",
  "title": "Programmable manual Router operator prepare input v1",
  "$comment": "Closed structural and size gate only. Accept only after the code-owned canonical validator re-derives every hash, Safe/ERC-1271 signature, GitHub Applicant 1.1.0 binding, Router ABI value, compilation, and simulation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvalClaim",
    "launchWallet",
    "permitLifetimeSeconds",
    "reviewedCompileInput",
    "schemaVersion"
  ],
  "properties": {
    "approvalClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalRevision",
        "approvedGitHubUserId",
        "approvedLaunchWallet",
        "compileInputHash",
        "headRepositoryId",
        "headSha",
        "planHash",
        "pullRequestNumber",
        "repositoryId",
        "schemaVersion",
        "treeSha"
      ],
      "properties": {
        "approvalRevision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvalId",
            "approvalVersion",
            "authorizedPrincipalHash",
            "configurationHash",
            "evidenceDigest",
            "headSha",
            "policyHash",
            "repositoryId",
            "reviewArtifactHash",
            "schemaVersion",
            "treeSha"
          ],
          "properties": {
            "approvalId": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "approvalVersion": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "authorizedPrincipalHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "configurationHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "evidenceDigest": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "headSha": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "policyHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "repositoryId": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "reviewArtifactHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "schemaVersion": {
              "const": "programmable.router-approval-revision.v2"
            },
            "treeSha": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            }
          }
        },
        "approvedGitHubUserId": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "approvedLaunchWallet": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "compileInputHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "headRepositoryId": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "headSha": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "planHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullRequestNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repositoryId": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "schemaVersion": {
          "const": "programmable.github-router-launch-approval-claim.v3"
        },
        "treeSha": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "maxLength": 78
        }
      }
    },
    "launchWallet": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "permitLifetimeSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reviewedCompileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "applicationManifestSha256",
        "compileInputHash",
        "compilerEvidenceDigest",
        "compilerProfileBindingHash",
        "externalDependencies",
        "requiresUniswapV4PoolManager",
        "schemaVersion",
        "sourceRevisionBindingHash",
        "stamp",
        "submissionMetadata",
        "targets"
      ],
      "properties": {
        "applicationId": {
          "type": "string",
          "maxLength": 1048576
        },
        "applicationManifestSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compileInputHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compilerEvidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compilerProfileBindingHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "externalDependencies": {
          "type": "array",
          "maxItems": 256,
          "items": {}
        },
        "requiresUniswapV4PoolManager": {
          "type": "boolean"
        },
        "schemaVersion": {
          "const": "programmable.stored-router-custom-graph-reviewed-compile-input.v1"
        },
        "sourceRevisionBindingHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stamp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fee",
            "hookTargetId",
            "launchId",
            "pairedCurrency",
            "schemaVersion",
            "tickSpacing",
            "tokenTargetId"
          ],
          "properties": {
            "fee": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "hookTargetId": {
              "type": "string",
              "maxLength": 1048576
            },
            "launchId": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "pairedCurrency": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "schemaVersion": {
              "const": "programmable.router-custom-graph-stamp-compile-input.v1"
            },
            "tickSpacing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tokenTargetId": {
              "type": "string",
              "maxLength": 1048576
            }
          }
        },
        "submissionMetadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicant",
            "applicantRequest",
            "hook",
            "metadataHash",
            "model",
            "platformFee",
            "requestedRoute",
            "schemaVersion",
            "source",
            "template"
          ],
          "properties": {
            "applicant": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "githubLogin",
                "launchWallet"
              ],
              "properties": {
                "githubLogin": {
                  "type": "string",
                  "maxLength": 1048576
                },
                "launchWallet": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{40}$"
                }
              }
            },
            "applicantRequest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonicalByteLength",
                "canonicalJsonUtf8",
                "canonicalSha256",
                "canonicalization",
                "evidenceHash",
                "rawByteLength",
                "rawJsonUtf8",
                "rawSha256",
                "requestPath",
                "schemaVersion"
              ],
              "properties": {
                "canonicalByteLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "canonicalJsonUtf8": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "canonicalSha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "canonicalization": {
                  "type": "string",
                  "maxLength": 1048576
                },
                "evidenceHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "rawByteLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "rawJsonUtf8": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "rawSha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "requestPath": {
                  "type": "string",
                  "maxLength": 1048576
                },
                "schemaVersion": {
                  "const": "programmable.hookbuilder-applicant-request-evidence.v1"
                }
              }
            },
            "hook": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 1048576
                },
                "version": {
                  "type": "string",
                  "maxLength": 1048576
                }
              }
            },
            "metadataHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 1048576
                },
                "version": {
                  "type": "string",
                  "maxLength": 1048576
                }
              }
            },
            "platformFee": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amountPips",
                "currencyBasis",
                "denominator",
                "mutable",
                "recipient"
              ],
              "properties": {
                "amountPips": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "currencyBasis": {
                  "type": "string",
                  "maxLength": 1048576
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "mutable": {
                  "type": "boolean"
                },
                "recipient": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^0x[0-9a-fA-F]{40}$"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "requestedRoute": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chainId",
                "routeId",
                "routeVersion"
              ],
              "properties": {
                "chainId": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)$",
                  "maxLength": 78
                },
                "routeId": {
                  "type": "string",
                  "maxLength": 1048576
                },
                "routeVersion": {
                  "type": "string",
                  "maxLength": 1048576
                }
              }
            },
            "schemaVersion": {
              "const": "programmable.router-reviewed-submission-metadata.v1"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commitSha",
                "repositoryId",
                "repositoryUrl",
                "treeSha"
              ],
              "properties": {
                "commitSha": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)$",
                  "maxLength": 78
                },
                "repositoryId": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)$",
                  "maxLength": 78
                },
                "repositoryUrl": {
                  "type": "string",
                  "maxLength": 1048576
                },
                "treeSha": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)$",
                  "maxLength": 78
                }
              }
            },
            "template": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 1048576
                },
                "version": {
                  "type": "string",
                  "maxLength": 1048576
                }
              }
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "applicantSalt",
              "constructorAddressLocators",
              "constructorArguments",
              "creationBytecode",
              "declaredHookPermissions",
              "deploymentValueWei",
              "expectedIdentity",
              "initializerAddressLocators",
              "initializerCalldata",
              "initializerValueWei",
              "targetId"
            ],
            "properties": {
              "applicantSalt": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              "constructorAddressLocators": {
                "type": "array",
                "maxItems": 256,
                "items": {}
              },
              "constructorArguments": {
                "type": "string",
                "pattern": "^0x(?:[0-9a-f]{2})*$",
                "maxLength": 2097154
              },
              "creationBytecode": {
                "type": "string",
                "pattern": "^0x(?:[0-9a-f]{2})*$",
                "maxLength": 2097154
              },
              "declaredHookPermissions": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 14,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "beforeInitialize",
                        "afterInitialize",
                        "beforeAddLiquidity",
                        "afterAddLiquidity",
                        "beforeRemoveLiquidity",
                        "afterRemoveLiquidity",
                        "beforeSwap",
                        "afterSwap",
                        "beforeDonate",
                        "afterDonate",
                        "beforeSwapReturnDelta",
                        "afterSwapReturnDelta",
                        "afterAddLiquidityReturnDelta",
                        "afterRemoveLiquidityReturnDelta"
                      ]
                    }
                  }
                ]
              },
              "deploymentValueWei": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)$",
                "maxLength": 78
              },
              "expectedIdentity": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "namespace",
                      "value"
                    ],
                    "properties": {
                      "namespace": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{40}$"
                      }
                    }
                  }
                ]
              },
              "initializerAddressLocators": {
                "type": "array",
                "maxItems": 256,
                "items": {}
              },
              "initializerCalldata": {
                "type": "string",
                "pattern": "^0x(?:[0-9a-f]{2})*$",
                "maxLength": 2097154
              },
              "initializerValueWei": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)$",
                "maxLength": 78
              },
              "targetId": {
                "type": "string",
                "maxLength": 1048576
              }
            }
          }
        }
      }
    },
    "schemaVersion": {
      "const": "programmable.manual-router-operator-prepare-input.v1"
    }
  }
}
