{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://proxy.gitbook.site/sites/site_V93gQ"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://proxy.gitbook.site/sites/site_V93gQ/:match*"
    }
  ],
  "crons": [
    {
      "path": "/api/ops/projector",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ops/market-projector",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ops/protocol-revenue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ops/custom-launch/generic-v2-projector",
      "schedule": "* * * * *"
    }
  ]
}
