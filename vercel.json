{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding, RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/models/prediction-markets",
      "destination": "/docs/tokens/prediction-markets",
      "permanent": true
    },
    {
      "source": "/sites/site_V93gQ",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/sites/site_V93gQ/:match*",
      "destination": "/docs/:match*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://proxy.gitbook.site/sites/site_V93gQ"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://proxy.gitbook.site/sites/site_V93gQ/:match*"
    }
  ],
  "crons": [
    {
      "path": "/api/ops/projector",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ops/market-projector",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ops/protocol-revenue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ops/alchemy-launch-refresh",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ops/custom-launch/generic-v2-projector",
      "schedule": "* * * * *"
    }
  ]
}
