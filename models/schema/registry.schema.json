{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xprogrammable/programmable/blob/main/models/schema/registry.schema.json",
  "title": "Programmable launch model registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "statuses",
    "models"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "statuses": {
      "type": "array",
      "const": [
        "design",
        "candidate",
        "available",
        "retired"
      ]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "summary",
          "manifest",
          "documentation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "design",
              "candidate",
              "available",
              "retired"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 20
          },
          "manifest": {
            "type": "string",
            "pattern": "^models/"
          },
          "documentation": {
            "type": "string",
            "pattern": "^models/"
          }
        }
      }
    }
  }
}
