{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xprogrammable/programmable/blob/main/models/schema/release.schema.json",
  "title": "Programmable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "model",
    "status",
    "network",
    "sourcePublicationCommit",
    "compiler",
    "evidence",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "release": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "status": {
      "const": "available"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "chainId"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "chainId": {
          "type": "integer"
        }
      }
    },
    "sourcePublicationCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solc",
        "evmVersion",
        "optimizerRuns"
      ],
      "properties": {
        "solc": {
          "type": "string"
        },
        "evmVersion": {
          "type": "string"
        },
        "optimizerRuns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification",
        "deployment",
        "security",
        "tests"
      ],
      "properties": {
        "specification": {
          "type": "string"
        },
        "deployment": {
          "type": "string"
        },
        "security": {
          "type": "string"
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independentAudit",
        "publicContest",
        "sourceVerification"
      ],
      "properties": {
        "independentAudit": {
          "type": "boolean"
        },
        "publicContest": {
          "type": "boolean"
        },
        "sourceVerification": {
          "type": "string"
        }
      }
    }
  }
}
